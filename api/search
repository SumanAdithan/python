":"/docs/phase-2","tags":[],"type":"text","url":"/docs/phase-2#goals","content":"`get`, `keys`, `values`, `items`","locale":"en"},"249":{"id":"/docs/phase-2-14","page_id":"/docs/phase-2","tags":[],"type":"text","url":"/docs/phase-2#goals","content":"`in`","locale":"en"},"250":{"id":"/docs/phase-2-15","page_id":"/docs/phase-2","tags":[],"type":"text","url":"/docs/phase-2#goals","content":"Each topic is its own page in the sidebar, taught with a JS/TS → Python comparison, followed\nby a small example.","locale":"en"},"251":{"id":"/docs/phase-2/list-methods","page_id":"/docs/phase-2/list-methods","type":"page","content":"append, remove & pop","breadcrumbs":["Docs","Python Notes","Phase 2 — Collections"],"tags":[],"url":"/docs/phase-2/list-methods","locale":"en"},"252":{"id":"/docs/phase-2/list-methods-0","page_id":"/docs/phase-2/list-methods","tags":[],"type":"text","url":"/docs/phase-2/list-methods","content":"The three list methods you'll use constantly","locale":"en"},"253":{"id":"/docs/phase-2/list-methods-1","page_id":"/docs/phase-2/list-methods","type":"heading","tags":[],"url":"/docs/phase-2/list-methods#append--add-to-the-end","content":"append — add to the end","locale":"en"},"254":{"id":"/docs/phase-2/list-methods-2","page_id":"/docs/phase-2/list-methods","type":"heading","tags":[],"url":"/docs/phase-2/list-methods#remove--delete-by-value","content":"remove — delete by value","locale":"en"},"255":{"id":"/docs/phase-2/list-methods-3","page_id":"/docs/phase-2/list-methods","type":"heading","tags":[],"url":"/docs/phase-2/list-methods#pop--remove-and-return","content":"pop — remove and return","locale":"en"},"256":{"id":"/docs/phase-2/list-methods-4","page_id":"/docs/phase-2/list-methods","tags":[],"type":"text","url":"/docs/phase-2/list-methods#append--add-to-the-end","content":"JavaScript:","locale":"en"},"257":{"id":"/docs/phase-2/list-methods-5","page_id":"/docs/phase-2/list-methods","tags":[],"type":"text","url":"/docs/phase-2/list-methods#append--add-to-the-end","content":"Python:","locale":"en"},"258":{"id":"/docs/phase-2/list-methods-6","page_id":"/docs/phase-2/list-methods","tags":[],"type":"text","url":"/docs/phase-2/list-methods#append--add-to-the-end","content":"`append()` is Python's `push()` — it always adds to the **end** of the list.","locale":"en"},"259":{"id":"/docs/phase-2/list-methods-7","page_id":"/docs/phase-2/list-methods","tags":[],"type":"text","url":"/docs/phase-2/list-methods#remove--delete-by-value","content":"Python's `remove()` deletes the **first matching value**, not an index.","locale":"en"},"260":{"id":"/docs/phase-2/list-methods-8","page_id":"/docs/phase-2/list-methods","tags":[],"type":"text","url":"/docs/phase-2/list-methods#remove--delete-by-value","content":"JS doesn't have a direct \"remove by value\" method — you'd normally write\n`arr.filter(f => f !== 'banana')` to get a new array without it.","locale":"en"},"261":{"id":"/docs/phase-2/list-methods-9","page_id":"/docs/phase-2/list-methods","tags":[],"type":"text","url":"/docs/phase-2/list-methods#remove--delete-by-value","content":"**Note:** if the value doesn't exist, `remove()` raises an error, so make sure it's actually\nin the list first (more on checking that with `in` later in this phase).","locale":"en"},"262":{"id":"/docs/phase-2/list-methods-10","page_id":"/docs/phase-2/list-methods","tags":[],"type":"text","url":"/docs/phase-2/list-methods#pop--remove-and-return","content":"`pop()` removes an item and gives it back to you.","locale":"en"},"263":{"id":"/docs/phase-2/list-methods-11","page_id":"/docs/phase-2/list-methods","tags":[],"type":"text","url":"/docs/phase-2/list-methods#pop--remove-and-return","content":"Just like JS's `arr.pop()`. But Python's `pop()` also accepts an **index**, which JS's\n`pop()` doesn't support directly:","locale":"en"},"264":{"id":"/docs/phase-2/lists","page_id":"/docs/phase-2/lists","type":"page","content":"list, Indexing & Slicing","breadcrumbs":["Docs","Python Notes","Phase 2 — Collections"],"tags":[],"url":"/docs/phase-2/lists","locale":"en"},"265":{"id":"/docs/phase-2/lists-0","page_id":"/docs/phase-2/lists","tags":[],"type":"text","url":"/docs/phase-2/lists","content":"Python's array — ordered, mutable, and allows duplicates","locale":"en"},"266":{"id":"/docs/phase-2/lists-1","page_id":"/docs/phase-2/lists","type":"heading","tags":[],"url":"/docs/phase-2/lists#list","content":"list","locale":"en"},"267":{"id":"/docs/phase-2/lists-2","page_id":"/docs/phase-2/lists","type":"heading","tags":[],"url":"/docs/phase-2/lists#indexing","content":"Indexing","locale":"en"},"268":{"id":"/docs/phase-2/lists-3","page_id":"/docs/phase-2/lists","type":"heading","tags":[],"url":"/docs/phase-2/lists#slicing","content":"Slicing","locale":"en"},"269":{"id":"/docs/phase-2/lists-4","page_id":"/docs/phase-2/lists","tags":[],"type":"text","url":"/docs/phase-2/lists#list","content":"Python's `list` is the equivalent of a JavaScript array. It's ordered, you can change it after\ncreating it, and it can hold duplicate values.","locale":"en"},"270":{"id":"/docs/phase-2/lists-5","page_id":"/docs/phase-2/lists","tags":[],"type":"text","url":"/docs/phase-2/lists#list","content":"JavaScript:","locale":"en"},"271":{"id":"/docs/phase-2/lists-6","page_id":"/docs/phase-2/lists","tags":[],"type":"text","url":"/docs/phase-2/lists#list","content":"Python:","locale":"en"},"272":{"id":"/docs/phase-2/lists-7","page_id":"/docs/phase-2/lists","tags":[],"type":"text","url":"/docs/phase-2/lists#list","content":"Same idea — square brackets, comma-separated values. `len()` gives you the size:","locale":"en"},"273":{"id":"/docs/phase-2/lists-8","page_id":"/docs/phase-2/lists","tags":[],"type":"text","url":"/docs/phase-2/lists#indexing","content":"Just like JS arrays, indexing starts at `0`.","locale":"en"},"274":{"id":"/docs/phase-2/lists-9","page_id":"/docs/phase-2/lists","tags":[],"type":"text","url":"/docs/phase-2/lists#indexing","content":"Python also supports **negative indexing** — a clean way to count from the end:","locale":"en"},"275":{"id":"/docs/phase-2/lists-10","page_id":"/docs/phase-2/lists","tags":[],"type":"text","url":"/docs/phase-2/lists#indexing","content":"In JS you'd reach for `arr.at(-1)` to get the same result; in Python `-1` just works directly\ninside the brackets.","locale":"en"},"276":{"id":"/docs/phase-2/lists-11","page_id":"/docs/phase-2/lists","tags":[],"type":"text","url":"/docs/phase-2/lists#slicing","content":"Slicing lets you grab a sub-list using `list[start:stop]`. Just like `range()`, `stop` is\n**not included**.","locale":"en"},"277":{"id":"/docs/phase-2/lists-12","page_id":"/docs/phase-2/lists","tags":[],"type":"text","url":"/docs/phase-2/lists#slicing","content":"JavaScript's closest equivalent is `arr.slice(start, stop)` — same start/stop behavior, just a\nmethod instead of bracket syntax.","locale":"en"},"278":{"id":"/docs/phase-2/lists-13","page_id":"/docs/phase-2/lists","tags":[],"type":"text","url":"/docs/phase-2/lists#slicing","content":"A common trick — reverse a list with a slice:","locale":"en"},"279":{"id":"/docs/phase-2/nested-data-and-in","page_id":"/docs/phase-2/nested-data-and-in","type":"page","content":"Nested Data & in","breadcrumbs":["Docs","Python Notes","Phase 2 — Collections"],"tags":[],"url":"/docs/phase-2/nested-data-and-in","locale":"en"},"280":{"id":"/docs/phase-2/nested-data-and-in-0","page_id":"/docs/phase-2/nested-data-and-in","tags":[],"type":"text","url":"/docs/phase-2/nested-data-and-in","content":"A list of dicts (very common in backend code), and Python's membership operator","locale":"en"},"281":{"id":"/docs/phase-2/nested-data-and-in-1","page_id":"/docs/phase-2/nested-data-and-in","type":"heading","tags":[],"url":"/docs/phase-2/nested-data-and-in#nested-data--a-list-of-dicts","content":"Nested data — a list of dicts","locale":"en"},"282":{"id":"/docs/phase-2/nested-data-and-in-2","page_id":"/docs/phase-2/nested-data-and-in","type":"heading","tags":[],"url":"/docs/phase-2/nested-data-and-in#in--membership-check","content":"in — membership check","locale":"en"},"283":{"id":"/docs/phase-2/nested-data-and-in-3","page_id":"/docs/phase-2/nested-data-and-in","type":"heading","tags":[],"url":"/docs/phase-2/nested-data-and-in#a-gotcha-coming-from-js","content":"A gotcha coming from JS","locale":"en"},"284":{"id":"/docs/phase-2/nested-data-and-in-4","page_id":"/docs/phase-2/nested-data-and-in","tags":[],"type":"text","url":"/docs/phase-2/nested-data-and-in#nested-data--a-list-of-dicts","content":"This is one of the most common shapes you'll deal with in backend code: a **list of\ndictionaries**, e.g. a list of users from a database.","locale":"en"},"285":{"id":"/docs/phase-2/nested-data-and-in-5","page_id":"/docs/phase-2/nested-data-and-in","tags":[],"type":"text","url":"/docs/phase-2/nested-data-and-in#nested-data--a-list-of-dicts","content":"JavaScript:","locale":"en"},"286":{"id":"/docs/phase-2/nested-data-and-in-6","page_id":"/docs/phase-2/nested-data-and-in","tags":[],"type":"text","url":"/docs/phase-2/nested-data-and-in#nested-data--a-list-of-dicts","content":"Python:","locale":"en"},"287":{"id":"/docs/phase-2/nested-data-and-in-7","page_id":"/docs/phase-2/nested-data-and-in","tags":[],"type":"text","url":"/docs/phase-2/nested-data-and-in#nested-data--a-list-of-dicts","content":"Each loop iteration gives you one dict, and you read from it with brackets — exactly like a\nstandalone dict.","locale":"en"},"288":{"id":"/docs/phase-2/nested-data-and-in-8","page_id":"/docs/phase-2/nested-data-and-in","tags":[],"type":"text","url":"/docs/phase-2/nested-data-and-in#in--membership-check","content":"`in` checks whether something exists inside a collection. It works on lists, dicts, sets, and\nstrings.","locale":"en"},"289":{"id":"/docs/phase-2/nested-data-and-in-9","page_id":"/docs/phase-2/nested-data-and-in","tags":[],"type":"text","url":"/docs/phase-2/nested-data-and-in#in--membership-check","content":"**Checking a list** — checks if a **value** is present:","locale":"en"},"290":{"id":"/docs/phase-2/nested-data-and-in-10","page_id":"/docs/phase-2/nested-data-and-in","tags":[],"type":"text","url":"/docs/phase-2/nested-data-and-in#in--membership-check","content":"**Checking a dict** — checks if a **key** is present (not a value):","locale":"en"},"291":{"id":"/docs/phase-2/nested-data-and-in-11","page_id":"/docs/phase-2/nested-data-and-in","tags":[],"type":"text","url":"/docs/phase-2/nested-data-and-in#in--membership-check","content":"**Checking a string** — checks for a substring:","locale":"en"},"292":{"id":"/docs/phase-2/nested-data-and-in-12","page_id":"/docs/phase-2/nested-data-and-in","tags":[],"type":"text","url":"/docs/phase-2/nested-data-and-in#a-gotcha-coming-from-js","content":"JS also has an `in` operator, but for **arrays** it checks the **index**, not the value —\nwhich is a common source of confusion:","locale":"en"},"293":{"id":"/docs/phase-2/nested-data-and-in-13","page_id":"/docs/phase-2/nested-data-and-in","tags":[],"type":"text","url":"/docs/phase-2/nested-data-and-in#a-gotcha-coming-from-js","content":"Python's `in` on a list always checks **values**, which matches JS's `arr.includes(x)` — not\nJS's own `in` operator. Keep that distinction in mind when moving between the two languages.","locale":"en"},"294":{"id":"/docs/phase-2/sets","page_id":"/docs/phase-2/sets","type":"page","content":"set","breadcrumbs":["Docs","Python Notes","Phase 2 — Collections"],"tags":[],"url":"/docs/phase-2/sets","locale":"en"},"295":{"id":"/docs/phase-2/sets-0","page_id":"/docs/phase-2/sets","tags":[],"type":"text","url":"/docs/phase-2/sets","content":"A collection that automatically removes duplicates","locale":"en"},"296":{"id":"/docs/phase-2/sets-1","page_id":"/docs/phase-2/sets","type":"heading","tags":[],"url":"/docs/phase-2/sets#adding-and-removing","content":"Adding and removing","locale":"en"},"297":{"id":"/docs/phase-2/sets-2","page_id":"/docs/phase-2/sets","type":"heading","tags":[],"url":"/docs/phase-2/sets#why-use-a-set","content":"Why use a set?","locale":"en"},"298":{"id":"/docs/phase-2/sets-3","page_id":"/docs/phase-2/sets","tags":[],"type":"text","url":"/docs/phase-2/sets","content":"A `set` stores **unique values only** — duplicates are automatically dropped, and there's no\nguaranteed order.","locale":"en"},"299":{"id":"/docs/phase-2/sets-4","page_id":"/docs/phase-2/sets","tags":[],"type":"text","url":"/docs/phase-2/sets","content":"JavaScript:","locale":"en"},"300":{"id":"/docs/phase-2/sets-5","page_id":"/docs/phase-2/sets","tags":[],"type":"text","url":"/docs/phase-2/sets","content":"Python:","locale":"en"},"301":{"id":"/docs/phase-2/sets-6","page_id":"/docs/phase-2/sets","tags":[],"type":"text","url":"/docs/phase-2/sets","content":"Notice sets use curly braces `{ }`, just like a dict — but with plain values instead of\nkey-value pairs. (An empty `{}` in Python actually creates a `dict`, not a set — use `set()`\nfor an empty set.)","locale":"en"},"302":{"id":"/docs/phase-2/sets-7","page_id":"/docs/phase-2/sets","tags":[],"type":"text","url":"/docs/phase-2/sets#adding-and-removing","content":"Same idea as JS's `set.add()` and `set.delete()`.","locale":"en"},"303":{"id":"/docs/phase-2/sets-8","page_id":"/docs/phase-2/sets","tags":[],"type":"text","url":"/docs/phase-2/sets#why-use-a-set","content":"The most common reason: removing duplicates from a list.","locale":"en"},"304":{"id":"/docs/phase-2/sets-9","page_id":"/docs/phase-2/sets","tags":[],"type":"text","url":"/docs/phase-2/sets#why-use-a-set","content":"Sets are also very fast for checking whether a value exists — you'll see this combined with\nthe `in` keyword later in this phase.","locale":"en"},"305":{"id":"/docs/phase-2/tuples","page_id":"/docs/phase-2/tuples","type":"page","content":"tuple","breadcrumbs":["Docs","Python Notes","Phase 2 — Collections"],"tags":[],"url":"/docs/phase-2/tuples","locale":"en"},"306":{"id":"/docs/phase-2/tuples-0","page_id":"/docs/phase-2/tuples","tags":[],"type":"text","url":"/docs/phase-2/tuples","content":"A list that can't be changed after it's created","locale":"en"},"307":{"id":"/docs/phase-2/tuples-1","page_id":"/docs/phase-2/tuples","type":"heading","tags":[],"url":"/docs/phase-2/tuples#why-use-a-tuple","content":"Why use a tuple?","locale":"en"},"308":{"id":"/docs/phase-2/tuples-2","page_id":"/docs/phase-2/tuples","tags":[],"type":"text","url":"/docs/phase-2/tuples","content":"A `tuple` looks like a list, but once it's created, it **can't be changed** — no adding,\nremoving, or replacing items.","locale":"en"},"309":{"id":"/docs/phase-2/tuples-3","page_id":"/docs/phase-2/tuples","tags":[],"type":"text","url":"/docs/phase-2/tuples","content":"JS doesn't have a true built-in equivalent — the closest is `Object.freeze()` on an array:","locale":"en"},"310":{"id":"/docs/phase-2/tuples-4","page_id":"/docs/phase-2/tuples","tags":[],"type":"text","url":"/docs/phase-2/tuples","content":"Python has a dedicated syntax for this — parentheses instead of square brackets:","locale":"en"},"311":{"id":"/docs/phase-2/tuples-5","page_id":"/docs/phase-2/tuples","tags":[],"type":"text","url":"/docs/phase-2/tuples","content":"Indexing and slicing work exactly the same as with a list:","locale":"en"},"312":{"id":"/docs/phase-2/tuples-6","page_id":"/docs/phase-2/tuples","tags":[],"type":"text","url":"/docs/phase-2/tuples","content":"But trying to change it fails:","locale":"en"},"313":{"id":"/docs/phase-2/tuples-7","page_id":"/docs/phase-2/tuples","tags":[],"type":"text","url":"/docs/phase-2/tuples#why-use-a-tuple","content":"Use a tuple when a value shouldn't change after it's created — for example, coordinates, an\nRGB color, or a fixed pair of values returned from a function. It signals to anyone reading\nthe code: \"this is a fixed collection, not something to mutate.\"","locale":"en"},"314":{"id":"/docs/phase-2/tuples-8","page_id":"/docs/phase-2/tuples","tags":[],"type":"text","url":"/docs/phase-2/tuples#why-use-a-tuple","content":"That last line — unpacking a tuple straight into two variables — is something JS can also do,\nvia array destructuring:","locale":"en"},"315":{"id":"/docs/phase-3/args-and-kwargs","page_id":"/docs/phase-3/args-and-kwargs","type":"page","content":"*args & **kwargs","breadcrumbs":["Docs","Python Notes","Phase 3 — Functions"],"tags":[],"url":"/docs/phase-3/args-and-kwargs","locale":"en"},"316":{"id":"/docs/phase-3/args-and-kwargs-0","page_id":"/docs/phase-3/args-and-kwargs","tags":[],"type":"text","url":"/docs/phase-3/args-and-kwargs","content":"Accepting any number of positional or keyword arguments","locale":"en"},"317":{"id":"/docs/phase-3/args-and-kwargs-1","page_id":"/docs/phase-3/args-and-kwargs","type":"heading","tags":[],"url":"/docs/phase-3/args-and-kwargs#args--any-number-of-positional-arguments","content":"*args — any number of positional arguments","locale":"en"},"318":{"id":"/docs/phase-3/args-and-kwargs-2","page_id":"/docs/phase-3/args-and-kwargs","type":"heading","tags":[],"url":"/docs/phase-3/args-and-kwargs#kwargs--any-number-of-keyword-arguments","content":"\\**kwargs — any number of keyword arguments","locale":"en"},"319":{"id":"/docs/phase-3/args-and-kwargs-3","page_id":"/docs/phase-3/args-and-kwargs","type":"heading","tags":[],"url":"/docs/phase-3/args-and-kwargs#naming-is-just-convention","content":"Naming is just convention","locale":"en"},"320":{"id":"/docs/phase-3/args-and-kwargs-4","page_id":"/docs/phase-3/args-and-kwargs","type":"heading","tags":[],"url":"/docs/phase-3/args-and-kwargs#using-them-together","content":"Using them together","locale":"en"},"321":{"id":"/docs/phase-3/args-and-kwargs-5","page_id":"/docs/phase-3/args-and-kwargs","tags":[],"type":"text","url":"/docs/phase-3/args-and-kwargs#args--any-number-of-positional-arguments","content":"`*args` collects every extra positional argument into a **tuple**.","locale":"en"},"322":{"id":"/docs/phase-3/args-and-kwargs-6","page_id":"/docs/phase-3/args-and-kwargs","tags":[],"type":"text","url":"/docs/phase-3/args-and-kwargs#args--any-number-of-positional-arguments","content":"JS's equivalent is rest parameters:","locale":"en"},"323":{"id":"/docs/phase-3/args-and-kwargs-7","page_id":"/docs/phase-3/args-and-kwargs","tags":[],"type":"text","url":"/docs/phase-3/args-and-kwargs#args--any-number-of-positional-arguments","content":"Same idea, different symbol — Python uses `*`, JS uses `...`.","locale":"en"},"324":{"id":"/docs/phase-3/args-and-kwargs-8","page_id":"/docs/phase-3/args-and-kwargs","tags":[],"type":"text","url":"/docs/phase-3/args-and-kwargs#kwargs--any-number-of-keyword-arguments","content":"`**kwargs` collects every extra `name=value` argument into a **dict**.","locale":"en"},"325":{"id":"/docs/phase-3/args-and-kwargs-9","page_id":"/docs/phase-3/args-and-kwargs","tags":[],"type":"text","url":"/docs/phase-3/args-and-kwargs#kwargs--any-number-of-keyword-arguments","content":"The closest JS equivalent is just accepting an object:","locale":"en"},"326":{"id":"/docs/phase-3/args-and-kwargs-10","page_id":"/docs/phase-3/args-and-kwargs","tags":[],"type":"text","url":"/docs/phase-3/args-and-kwargs#kwargs--any-number-of-keyword-arguments","content":"The difference: in Python the caller doesn't wrap anything in braces — `**kwargs` gathers up\nwhatever named arguments were passed directly.","locale":"en"},"327":{"id":"/docs/phase-3/args-and-kwargs-11","page_id":"/docs/phase-3/args-and-kwargs","tags":[],"type":"text","url":"/docs/phase-3/args-and-kwargs#naming-is-just-convention","content":"`args` and `kwargs` aren't keywords — only the `*` and `**` matter. You could name them\nanything, but `*args`/`**kwargs` is the convention you'll see in almost all Python code.","locale":"en"},"328":{"id":"/docs/phase-3/args-and-kwargs-12","page_id":"/docs/phase-3/args-and-kwargs","tags":[],"type":"text","url":"/docs/phase-3/args-and-kwargs#using-them-together","content":"A function can accept regular parameters, `*args`, and `**kwargs` all at once — always in\nthis order:","locale":"en"},"329":{"id":"/docs/phase-3/default-and-keyword-arguments","page_id":"/docs/phase-3/default-and-keyword-arguments","type":"page","content":"Default & Keyword Arguments","breadcrumbs":["Docs","Python Notes","Phase 3 — Functions"],"tags":[],"url":"/docs/phase-3/default-and-keyword-arguments","locale":"en"},"330":{"id":"/docs/phase-3/default-and-keyword-arguments-0","page_id":"/docs/phase-3/default-and-keyword-arguments","tags":[],"type":"text","url":"/docs/phase-3/default-and-keyword-arguments","content":"Optional parameters, and calling functions by argument name","locale":"en"},"331":{"id":"/docs/phase-3/default-and-keyword-arguments-1","page_id":"/docs/phase-3/default-and-keyword-arguments","type":"heading","tags":[],"url":"/docs/phase-3/default-and-keyword-arguments#default-parameters","content":"Default parameters","locale":"en"},"332":{"id":"/docs/phase-3/default-and-keyword-arguments-2","page_id":"/docs/phase-3/default-and-keyword-arguments","type":"heading","tags":[],"url":"/docs/phase-3/default-and-keyword-arguments#keyword-arguments","content":"Keyword arguments","locale":"en"},"333":{"id":"/docs/phase-3/default-and-keyword-arguments-3","page_id":"/docs/phase-3/default-and-keyword-arguments","tags":[],"type":"text","url":"/docs/phase-3/default-and-keyword-arguments#default-parameters","content":"Give a parameter a default value, and it becomes optional to pass in — same idea as JS.","locale":"en"},"334":{"id":"/docs/phase-3/default-and-keyword-arguments-4","page_id":"/docs/phase-3/default-and-keyword-arguments","tags":[],"type":"text","url":"/docs/phase-3/default-and-keyword-arguments#default-parameters","content":"JavaScript:","locale":"en"},"335":{"id":"/docs/phase-3/default-and-keyword-arguments-5","page_id":"/docs/phase-3/default-and-keyword-arguments","tags":[],"type":"text","url":"/docs/phase-3/default-and-keyword-arguments#default-parameters","content":"Python:","locale":"en"},"336":{"id":"/docs/phase-3/default-and-keyword-arguments-6","page_id":"/docs/phase-3/default-and-keyword-arguments","tags":[],"type":"text","url":"/docs/phase-3/default-and-keyword-arguments#keyword-arguments","content":"Python lets you call a function using `parameter_name=value`, in **any order**:","locale":"en"},"337":{"id":"/docs/phase-3/default-and-keyword-arguments-7","page_id":"/docs/phase-3/default-and-keyword-arguments","tags":[],"type":"text","url":"/docs/phase-3/default-and-keyword-arguments#keyword-arguments","content":"JS has no direct equivalent for this — the closest you can get is destructuring an object\nparameter, which forces the caller to pass named values instead of positional ones:","locale":"en"},"338":{"id":"/docs/phase-3/default-and-keyword-arguments-8","page_id":"/docs/phase-3/default-and-keyword-arguments","tags":[],"type":"text","url":"/docs/phase-3/default-and-keyword-arguments#keyword-arguments","content":"In Python you get that same \"call by name\" convenience for free, without wrapping anything\nin an object — positional and keyword calls both work on the same function:","locale":"en"},"339":{"id":"/docs/phase-3/default-and-keyword-arguments-9","page_id":"/docs/phase-3/default-and-keyword-arguments","tags":[],"type":"text","url":"/docs/phase-3/default-and-keyword-arguments#keyword-arguments","content":"Keyword arguments are especially useful when a function has several parameters, since they\nmake each call self-documenting.","locale":"en"},"340":{"id":"/docs/phase-3/functions-basics","page_id":"/docs/phase-3/functions-basics","type":"page","content":"Defining Functions","breadcrumbs":["Docs","Python Notes","Phase 3 — Functions"],"tags":[],"url":"/docs/phase-3/functions-basics","locale":"en"},"341":{"id":"/docs/phase-3/functions-basics-0","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics","content":"def instead of function, parameters, and return","locale":"en"},"342":{"id":"/docs/phase-3/functions-basics-1","page_id":"/docs/phase-3/functions-basics","type":"heading","tags":[],"url":"/docs/phase-3/functions-basics#defining-a-function","content":"Defining a function","locale":"en"},"343":{"id":"/docs/phase-3/functions-basics-2","page_id":"/docs/phase-3/functions-basics","type":"heading","tags":[],"url":"/docs/phase-3/functions-basics#calling-a-function","content":"Calling a function","locale":"en"},"344":{"id":"/docs/phase-3/functions-basics-3","page_id":"/docs/phase-3/functions-basics","type":"heading","tags":[],"url":"/docs/phase-3/functions-basics#parameters","content":"Parameters","locale":"en"},"345":{"id":"/docs/phase-3/functions-basics-4","page_id":"/docs/phase-3/functions-basics","type":"heading","tags":[],"url":"/docs/phase-3/functions-basics#return","content":"return","locale":"en"},"346":{"id":"/docs/phase-3/functions-basics-5","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#defining-a-function","content":"JavaScript:","locale":"en"},"347":{"id":"/docs/phase-3/functions-basics-6","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#defining-a-function","content":"Python:","locale":"en"},"348":{"id":"/docs/phase-3/functions-basics-7","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#defining-a-function","content":"Notice the pattern you already know from earlier phases:","locale":"en"},"349":{"id":"/docs/phase-3/functions-basics-8","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#defining-a-function","content":"JS/TS","locale":"en"},"350":{"id":"/docs/phase-3/functions-basics-9","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#defining-a-function","content":"Python","locale":"en"},"351":{"id":"/docs/phase-3/functions-basics-10","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#defining-a-function","content":"`function`","locale":"en"},"352":{"id":"/docs/phase-3/functions-basics-11","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#defining-a-function","content":"`def`","locale":"en"},"353":{"id":"/docs/phase-3/functions-basics-12","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#defining-a-function","content":"`{ }`","locale":"en"},"354":{"id":"/docs/phase-3/functions-basics-13","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#defining-a-function","content":"`:` + indentation","locale":"en"},"355":{"id":"/docs/phase-3/functions-basics-14","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#defining-a-function","content":"`;`","locale":"en"},"356":{"id":"/docs/phase-3/functions-basics-15","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#defining-a-function","content":"not required","locale":"en"},"357":{"id":"/docs/phase-3/functions-basics-16","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#calling-a-function","content":"Exactly the same as JS:","locale":"en"},"358":{"id":"/docs/phase-3/functions-basics-17","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#parameters","content":"`a` and `b` above are **parameters** — the values a function expects when it's called.\nPython doesn't require declaring their type (we'll add that with type hints next), it just\nuses whatever value gets passed in.","locale":"en"},"359":{"id":"/docs/phase-3/functions-basics-18","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#return","content":"`return` works exactly like in JS — it sends a value back to the caller and immediately exits\nthe function.","locale":"en"},"360":{"id":"/docs/phase-3/functions-basics-19","page_id":"/docs/phase-3/functions-basics","tags":[],"type":"text","url":"/docs/phase-3/functions-basics#return","content":"If a Python function has no `return` statement, it returns `None` — the same idea as a JS\nfunction with no `return` returning `undefined`.","locale":"en"},"361":{"id":"/docs/phase-3","page_id":"/docs/phase-3","type":"page","content":"Phase 3 — Functions","breadcrumbs":["Docs","Python Notes","Phase 3 — Functions"],"tags":[],"url":"/docs/phase-3","locale":"en"},"362":{"id":"/docs/phase-3-0","page_id":"/docs/phase-3","tags":[],"type":"text","url":"/docs/phase-3","content":"Goals for this phase, and a full JS/TS → Python cheat sheet","locale":"en"},"363":{"id":"/docs/phase-3-1","page_id":"/docs/phase-3","type":"heading","tags":[],"url":"/docs/phase-3#goals","content":"Goals","locale":"en"},"364":{"id":"/docs/phase-3-2","page_id":"/docs/phase-3","type":"heading","tags":[],"url":"/docs/phase-3#cheat-sheet","content":"Cheat sheet","locale":"en"},"365":{"id":"/docs/phase-3-3","page_id":"/docs/phase-3","tags":[],"type":"text","url":"/docs/phase-3","content":"Estimated time: **\\~1 hour**.","locale":"en"},"366":{"id":"/docs/phase-3-4","page_id":"/docs/phase-3","tags":[],"type":"text","url":"/docs/phase-3#goals","content":"By the end of this phase you should be comfortable with:","locale":"en"},"367":{"id":"/docs/phase-3-5","page_id":"/docs/phase-3","tags":[],"type":"text","url":"/docs/phase-3#goals","content":"parameters","locale":"en"},"368":{"id":"/docs/phase-3-6","page_id":"/docs/phase-3","tags":[],"type":"text","url":"/docs/phase-3#goals","content":"`return`","locale":"en"},"369":{"id":"/docs/phase-3-7","page_id":"/docs/phase-3","tags":[],"type":"text","url":"/docs/phase-3#goals","content":"default parameters","locale":"en"},"370":{"id":"/docs/phase-3-8","page_id":"/docs/phase-3","tags":[],"type":"text","url":"/docs/phase-3#goals","content":"keyword arguments","locale":"en"},"371":{"id":"/docs/phase-3-9","page_id":"/docs/phase-3","tags":[],"type":"text","url":"/docs/phase-3#goals","content":"type hints","locale":"en"},"372":{"id":"/docs/phase-3-10","page_id":"/docs/phase-3","tags":[],"type":"text","url":"/docs/phase-3#goals","content":"`*args`","locale":"en"},"373":{"id":"/docs/phase-3-11","page_id":"/docs/phase-3","tags":[],"type":"text","url":"/docs/phase-3#goals","content":"`**kwargs` basics","locale":"en"},"374":{"id":"/docs/phase-3-12","page_id":"/docs/phase-3","tags":[],"type":"text","url":"/docs/phase-3#goals","content":"Type hints are especially important here — **FastAPI reads them** to validate requests and\ngenerate docs automatically, so getting comfortable with them now pays off later.","locale":"en"},"375":{"id":"/docs/phase-3-13","page_id":"/docs/phase-3","tags":[],"type":"text","url":"/docs/phase-3#goals","content":"Each topic is its own page in the sidebar, taught with a JS/TS → Python comparison, followed\nby a small example.","locale":"en"},"376":{"id":"/docs/phase-3/type-hints","page_id":"/docs/phase-3/type-hints","type":"page","content":"Type Hints","breadcrumbs":["Docs","Python Notes","Phase 3 — Functions"],"tags":[],"url":"/docs/phase-3/type-hints","locale":"en"},"377":{"id":"/docs/phase-3/type-hints-0","page_id":"/docs/phase-3/type-hints","tags":[],"type":"text","url":"/docs/phase-3/type-hints","content":"The Python equivalent of TypeScript's parameter and return types","locale":"en"},"378":{"id":"/docs/phase-3/type-hints-1","page_id":"/docs/phase-3/type-hints","type":"heading","tags":[],"url":"/docs/phase-3/type-hints#important-difference-from-typescript","content":"Important difference from TypeScript","locale":"en"},"379":{"id":"/docs/phase-3/type-hints-2","page_id":"/docs/phase-3/type-hints","type":"heading","tags":[],"url":"/docs/phase-3/type-hints#why-they-matter-for-fastapi","content":"Why they matter for FastAPI","locale":"en"},"380":{"id":"/docs/phase-3/type-hints-3","page_id":"/docs/phase-3/type-hints","type":"heading","tags":[],"url":"/docs/phase-3/type-hints#common-types-youll-use","content":"Common types you'll use","locale":"en"},"381":{"id":"/docs/phase-3/type-hints-4","page_id":"/docs/phase-3/type-hints","type":"heading","tags":[],"url":"/docs/phase-3/type-hints#optional-values","content":"Optional values","locale":"en"},"382":{"id":"/docs/phase-3/type-hints-5","page_id":"/docs/phase-3/type-hints","tags":[],"type":"text","url":"/docs/phase-3/type-hints","content":"Once a function works, you can annotate it with **type hints** — they describe what type\neach parameter and the return value should be.","locale":"en"},"383":{"id":"/docs/phase-3/type-hints-6","page_id":"/docs/phase-3/type-hints","tags":[],"type":"text","url":"/docs/phase-3/type-hints","content":"`a: int` and `b: int` — each parameter's expected type","locale":"en"},"384":{"id":"/docs/phase-3/type-hints-7","page_id":"/docs/phase-3/type-hints","tags":[],"type":"text","url":"/docs/phase-3/type-hints","content":"`-> int` — the return type","locale":"en"},"385":{"id":"/docs/phase-3/type-hints-8","page_id":"/docs/phase-3/type-hints","tags":[],"type":"text","url":"/docs/phase-3/type-hints","content":"This should look very familiar coming from TypeScript:","locale":"en"},"386":{"id":"/docs/phase-3/type-hints-9","page_id":"/docs/phase-3/type-hints","tags":[],"type":"text","url":"/docs/phase-3/type-hints#important-difference-from-typescript","content":"TypeScript's types are checked **at compile time** — the compiler will refuse to build code\nthat violates them. Python's type hints are **not enforced at all** by the language itself.\nThey're purely documentation for humans and tools:","locale":"en"},"387":{"id":"/docs/phase-3/type-hints-10","page_id":"/docs/phase-3/type-hints","tags":[],"type":"text","url":"/docs/phase-3/type-hints#important-difference-from-typescript","content":"Nothing crashes here — Python just runs the code as written. The hints only matter to tools\nthat choose to read them.","locale":"en"},"388":{"id":"/docs/phase-3/type-hints-11","page_id":"/docs/phase-3/type-hints","tags":[],"type":"text","url":"/docs/phase-3/type-hints#why-they-matter-for-fastapi","content":"This is the big one: **FastAPI reads your type hints at runtime** and uses them to validate\nincoming requests, convert data automatically, and generate interactive API docs — without\nyou writing any extra validation code. So while plain Python ignores type hints, the\nframeworks you're heading toward absolutely do not.","locale":"en"},"389":{"id":"/docs/phase-3/type-hints-12","page_id":"/docs/phase-3/type-hints","tags":[],"type":"text","url":"/docs/phase-3/type-hints#optional-values","content":"If a value might be `None`, mark it explicitly:","locale":"en"},"390":{"id":"/docs/phase-3/type-hints-13","page_id":"/docs/phase-3/type-hints","tags":[],"type":"text","url":"/docs/phase-3/type-hints#optional-values","content":"`str | None` reads as \"a string, or `None`\" — the same idea as TypeScript's\n`string | null`.","locale":"en"},"391":{"id":"/docs/phase-4/classes-and-objects","page_id":"/docs/phase-4/classes-and-objects","type":"page","content":"class & object","breadcrumbs":["Docs","Python Notes","Phase 4 — Python OOP"],"tags":[],"url":"/docs/phase-4/classes-and-objects","locale":"en"},"392":{"id":"/docs/phase-4/classes-and-objects-0","page_id":"/docs/phase-4/classes-and-objects","tags":[],"type":"text","url":"/docs/phase-4/classes-and-objects","content":"Defining a class, and creating an object from it — no new keyword","locale":"en"},"393":{"id":"/docs/phase-4/classes-and-objects-1","page_id":"/docs/phase-4/classes-and-objects","type":"heading","tags":[],"url":"/docs/phase-4/classes-and-objects#class","content":"class","locale":"en"},"394":{"id":"/docs/phase-4/classes-and-objects-2","page_id":"/docs/phase-4/classes-and-objects","type":"heading","tags":[],"url":"/docs/phase-4/classes-and-objects#object","content":"object","locale":"en"},"395":{"id":"/docs/phase-4/classes-and-objects-3","page_id":"/docs/phase-4/classes-and-objects","tags":[],"type":"text","url":"/docs/phase-4/classes-and-objects#class","content":"A class is a blueprint for creating objects. The keyword is the same word you already know:","locale":"en"},"396":{"id":"/docs/phase-4/classes-and-objects-4","page_id":"/docs/phase-4/classes-and-objects","tags":[],"type":"text","url":"/docs/phase-4/classes-and-objects#class","content":"TypeScript:","locale":"en"},"397":{"id":"/docs/phase-4/classes-and-objects-5","page_id":"/docs/phase-4/classes-and-objects","tags":[],"type":"text","url":"/docs/phase-4/classes-and-objects#class","content":"Python:","locale":"en"},"398":{"id":"/docs/phase-4/classes-and-objects-6","page_id":"/docs/phase-4/classes-and-objects","tags":[],"type":"text","url":"/docs/phase-4/classes-and-objects#class","content":"Same pattern as functions: `:` + indentation instead of `{ }`. `pass` just means \"empty body\nfor now\" (you saw this back in Phase 1).","locale":"en"},"399":{"id":"/docs/phase-4/classes-and-objects-7","page_id":"/docs/phase-4/classes-and-objects","tags":[],"type":"text","url":"/docs/phase-4/classes-and-objects#object","content":"An **object** (Python calls it an **instance**) is a real value created from a class.","locale":"en"},"400":{"id":"/docs/phase-4/classes-and-objects-8","page_id":"/docs/phase-4/classes-and-objects","tags":[],"type":"text","url":"/docs/phase-4/classes-and-objects#object","content":"TypeScript:","locale":"en"},"401":{"id":"/docs/phase-4/classes-and-objects-9","page_id":"/docs/phase-4/classes-and-objects","tags":[],"type":"text","url":"/docs/phase-4/classes-and-objects#object","content":"Python:","locale":"en"},"402":{"id":"/docs/phase-4/classes-and-objects-10","page_id":"/docs/phase-4/classes-and-objects","tags":[],"type":"text","url":"/docs/phase-4/classes-and-objects#object","content":"The one thing to unlearn: **Python has no `new` keyword**. Calling the class name like a\nfunction creates the object.","locale":"en"},"403":{"id":"/docs/phase-4","page_id":"/docs/phase-4","type":"page","content":"Phase 4 — Python OOP","breadcrumbs":["Docs","Python Notes","Phase 4 — Python OOP"],"tags":[],"url":"/docs/phase-4","locale":"en"},"404":{"id":"/docs/phase-4-0","page_id":"/docs/phase-4","tags":[],"type":"text","url":"/docs/phase-4","content":"Goals for this phase, and a full TypeScript → Python cheat sheet","locale":"en"},"405":{"id":"/docs/phase-4-1","page_id":"/docs/phase-4","type":"heading","tags":[],"url":"/docs/phase-4#goals","content":"Goals","locale":"en"},"406":{"id":"/docs/phase-4-2","page_id":"/docs/phase-4","type":"heading","tags":[],"url":"/docs/phase-4#cheat-sheet","content":"Cheat sheet","locale":"en"},"407":{"id":"/docs/phase-4-3","page_id":"/docs/phase-4","tags":[],"type":"text","url":"/docs/phase-4","content":"Estimated time: **\\~1.5 hours**.","locale":"en"},"408":{"id":"/docs/phase-4-4","page_id":"/docs/phase-4","tags":[],"type":"text","url":"/docs/phase-4","content":"Don't go deep here — just enough OOP to read and write simple classes. Your TypeScript\nknowledge makes this easy, since Python classes work almost exactly the same way.","locale":"en"},"409":{"id":"/docs/phase-4-5","page_id":"/docs/phase-4","tags":[],"type":"text","url":"/docs/phase-4#goals","content":"By the end of this phase you should understand:","locale":"en"},"410":{"id":"/docs/phase-4-6","page_id":"/docs/phase-4","tags":[],"type":"text","url":"/docs/phase-4#goals","content":"`class`","locale":"en"},"411":{"id":"/docs/phase-4-7","page_id":"/docs/phase-4","tags":[],"type":"text","url":"/docs/phase-4#goals","content":"object","locale":"en"},"412":{"id":"/docs/phase-4-8","page_id":"/docs/phase-4","tags":[],"type":"text","url":"/docs/phase-4#goals","content":"`__init__`","locale":"en"},"413":{"id":"/docs/phase-4-9","page_id":"/docs/phase-4","tags":[],"type":"text","url":"/docs/phase-4#goals","content":"`self`","locale":"en"},"414":{"id":"/docs/phase-4-10","page_id":"/docs/phase-4","tags":[],"type":"text","url":"/docs/phase-4#goals","content":"instance variables","locale":"en"},"415":{"id":"/docs/phase-4-11","page_id":"/docs/phase-4","tags":[],"type":"text","url":"/docs/phase-4#goals","content":"methods","locale":"en"},"416":{"id":"/docs/phase-4-12","page_id":"/docs/phase-4","tags":[],"type":"text","url":"/docs/phase-4#goals","content":"inheritance","locale":"en"},"417":{"id":"/docs/phase-4-13","page_id":"/docs/phase-4","tags":[],"type":"text","url":"/docs/phase-4#goals","content":"`super()`","locale":"en"},"418":{"id":"/docs/phase-4-14","page_id":"/docs/phase-4","tags":[],"type":"text","url":"/docs/phase-4#goals","content":"Each topic is its own page in the sidebar, taught with a TypeScript → Python comparison,\nfollowed by a small example.","locale":"en"},"419":{"id":"/docs/phase-4/inheritance","page_id":"/docs/phase-4/inheritance","type":"page","content":"Inheritance & super()","breadcrumbs":["Docs","Python Notes","Phase 4 — Python OOP"],"tags":[],"url":"/docs/phase-4/inheritance","locale":"en"},"420":{"id":"/docs/phase-4/inheritance-0","page_id":"/docs/phase-4/inheritance","tags":[],"type":"text","url":"/docs/phase-4/inheritance","content":"extends becomes parentheses, and super() works almost the same","locale":"en"},"421":{"id":"/docs/phase-4/inheritance-1","page_id":"/docs/phase-4/inheritance","type":"heading","tags":[],"url":"/docs/phase-4/inheritance#inheritance","content":"Inheritance","locale":"en"},"422":{"id":"/docs/phase-4/inheritance-2","page_id":"/docs/phase-4/inheritance","type":"heading","tags":[],"url":"/docs/phase-4/inheritance#super","content":"super()","locale":"en"},"423":{"id":"/docs/phase-4/inheritance-3","page_id":"/docs/phase-4/inheritance","tags":[],"type":"text","url":"/docs/phase-4/inheritance#inheritance","content":"TypeScript's `extends` becomes **parentheses after the class name** in Python.","locale":"en"},"424":{"id":"/docs/phase-4/inheritance-4","page_id":"/docs/phase-4/inheritance","tags":[],"type":"text","url":"/docs/phase-4/inheritance#inheritance","content":"TypeScript:","locale":"en"},"425":{"id":"/docs/phase-4/inheritance-5","page_id":"/docs/phase-4/inheritance","tags":[],"type":"text","url":"/docs/phase-4/inheritance#inheritance","content":"Python:","locale":"en"},"426":{"id":"/docs/phase-4/inheritance-6","page_id":"/docs/phase-4/inheritance","tags":[],"type":"text","url":"/docs/phase-4/inheritance#inheritance","content":"`Dog` inherits everything from `Animal` — including `__init__` — and only overrides\n`speak()`.","locale":"en"},"427":{"id":"/docs/phase-4/inheritance-7","page_id":"/docs/phase-4/inheritance","tags":[],"type":"text","url":"/docs/phase-4/inheritance#super","content":"If a child class needs its **own** `__init__` but still wants the parent's setup logic to\nrun, call `super()` — same idea as TypeScript's `super(...)` inside a constructor.","locale":"en"},"428":{"id":"/docs/phase-4/inheritance-8","page_id":"/docs/phase-4/inheritance","tags":[],"type":"text","url":"/docs/phase-4/inheritance#super","content":"TypeScript:","locale":"en"},"429":{"id":"/docs/phase-4/inheritance-9","page_id":"/docs/phase-4/inheritance","tags":[],"type":"text","url":"/docs/phase-4/inheritance#super","content":"Python:","locale":"en"},"430":{"id":"/docs/phase-4/inheritance-10","page_id":"/docs/phase-4/inheritance","tags":[],"type":"text","url":"/docs/phase-4/inheritance#super","content":"The difference: TypeScript calls `super(name)` directly; Python calls `super()` first (no\narguments) to get a reference to the parent, then calls `.__init__(name)` on it. Same result\n— the parent's constructor runs and sets up `self.name` before `Dog` adds anything of its\nown.","locale":"en"},"431":{"id":"/docs/phase-4/init-and-self","page_id":"/docs/phase-4/init-and-self","type":"page","content":"__init__ & self","breadcrumbs":["Docs","Python Notes","Phase 4 — Python OOP"],"tags":[],"url":"/docs/phase-4/init-and-self","locale":"en"},"432":{"id":"/docs/phase-4/init-and-self-0","page_id":"/docs/phase-4/init-and-self","tags":[],"type":"text","url":"/docs/phase-4/init-and-self","content":"Python's constructor, and the explicit stand-in for this","locale":"en"},"433":{"id":"/docs/phase-4/init-and-self-1","page_id":"/docs/phase-4/init-and-self","type":"heading","tags":[],"url":"/docs/phase-4/init-and-self#init--the-constructor","content":"**init** — the constructor","locale":"en"},"434":{"id":"/docs/phase-4/init-and-self-2","page_id":"/docs/phase-4/init-and-self","type":"heading","tags":[],"url":"/docs/phase-4/init-and-self#self--pythons-this","content":"self — Python's this","locale":"en"},"435":{"id":"/docs/phase-4/init-and-self-3","page_id":"/docs/phase-4/init-and-self","type":"heading","tags":[],"url":"/docs/phase-4/init-and-self#instance-variables","content":"Instance variables","locale":"en"},"436":{"id":"/docs/phase-4/init-and-self-4","page_id":"/docs/phase-4/init-and-self","tags":[],"type":"text","url":"/docs/phase-4/init-and-self#init--the-constructor","content":"`__init__` is Python's constructor — it runs automatically when you create an object, just\nlike TypeScript's `constructor`.","locale":"en"},"437":{"id":"/docs/phase-4/init-and-self-5","page_id":"/docs/phase-4/init-and-self","tags":[],"type":"text","url":"/docs/phase-4/init-and-self#init--the-constructor","content":"TypeScript:","locale":"en"},"438":{"id":"/docs/phase-4/init-and-self-6","page_id":"/docs/phase-4/init-and-self","tags":[],"type":"text","url":"/docs/phase-4/init-and-self#init--the-constructor","content":"Python:","locale":"en"},"439":{"id":"/docs/phase-4/init-and-self-7","page_id":"/docs/phase-4/init-and-self","tags":[],"type":"text","url":"/docs/phase-4/init-and-self#self--pythons-this","content":"`self` refers to the current object, same job as `this&#x60; in TypeScript. The key difference:\n**`self` must be written explicitly as the first parameter of every method** — Python never\nadds it for you invisibly like JS/TS does with `this`.","locale":"en"},"440":{"id":"/docs/phase-4/init-and-self-8","page_id":"/docs/phase-4/init-and-self","tags":[],"type":"text","url":"/docs/phase-4/init-and-self#instance-variables","content":"`self.name` and `self.age` are **instance variables** — data that belongs to that one\nspecific object, exactly like `this.name` in a TS class. Each object you create gets its own\ncopy:","locale":"en"},"441":{"id":"/docs/phase-4/methods","page_id":"/docs/phase-4/methods","type":"page","content":"Methods","breadcrumbs":["Docs","Python Notes","Phase 4 — Python OOP"],"tags":[],"url":"/docs/phase-4/methods","locale":"en"},"442":{"id":"/docs/phase-4/methods-0","page_id":"/docs/phase-4/methods","tags":[],"type":"text","url":"/docs/phase-4/methods","content":"Functions that belong to a class — and why self still shows up","locale":"en"},"443":{"id":"/docs/phase-4/methods-1","page_id":"/docs/phase-4/methods","type":"heading","tags":[],"url":"/docs/phase-4/methods#self-shows-up-again","content":"self shows up again","locale":"en"},"444":{"id":"/docs/phase-4/methods-2","page_id":"/docs/phase-4/methods","tags":[],"type":"text","url":"/docs/phase-4/methods","content":"A **method** is just a function defined inside a class. `__init__` is technically a method\ntoo — just a special one that runs on creation.","locale":"en"},"445":{"id":"/docs/phase-4/methods-3","page_id":"/docs/phase-4/methods","tags":[],"type":"text","url":"/docs/phase-4/methods","content":"TypeScript:","locale":"en"},"446":{"id":"/docs/phase-4/methods-4","page_id":"/docs/phase-4/methods","tags":[],"type":"text","url":"/docs/phase-4/methods","content":"Python:","locale":"en"},"447":{"id":"/docs/phase-4/methods-5","page_id":"/docs/phase-4/methods","tags":[],"type":"text","url":"/docs/phase-4/methods#self-shows-up-again","content":"Every method needs `self` as its first parameter, so it can read the object's instance\nvariables (`self.name` here). This is the same `self` from the last page — Python just\nrequires you to name it explicitly in every method's signature.","locale":"en"},"448":{"id":"/docs/phase-4/methods-6","page_id":"/docs/phase-4/methods","tags":[],"type":"text","url":"/docs/phase-4/methods#self-shows-up-again","content":"**But you don't pass it yourself when calling the method** — `user.greet()`, not\n`user.greet(user)`. Python fills in `self` automatically with whatever object is before the\ndot; you only ever pass the *remaining* parameters.","locale":"en"},"449":{"id":"/docs/phase-5/dictionary-comprehension","page_id":"/docs/phase-5/dictionary-comprehension","type":"page","content":"Dictionary Comprehension","breadcrumbs":["Docs","Python Notes","Phase 5 — Python-specific Features"],"tags":[],"url":"/docs/phase-5/dictionary-comprehension","locale":"en"},"450":{"id":"/docs/phase-5/dictionary-comprehension-0","page_id":"/docs/phase-5/dictionary-comprehension","tags":[],"type":"text","url":"/docs/phase-5/dictionary-comprehension","content":"The same idea as list comprehension, but building a dict","locale":"en"},"451":{"id":"/docs/phase-5/dictionary-comprehension-1","page_id":"/docs/phase-5/dictionary-comprehension","tags":[],"type":"text","url":"/docs/phase-5/dictionary-comprehension","content":"Same idea as a list comprehension, but it builds a `dict` — with a `key: value` pair on\neach side instead of a single expression.","locale":"en"},"452":{"id":"/docs/phase-5/dictionary-comprehension-2","page_id":"/docs/phase-5/dictionary-comprehension","tags":[],"type":"text","url":"/docs/phase-5/dictionary-comprehension","content":"JS has no direct equivalent this clean — you'd normally build an array of `[key, value]`\npairs and convert it with `Object.fromEntries()`:","locale":"en"},"453":{"id":"/docs/phase-5/dictionary-comprehension-3","page_id":"/docs/phase-5/dictionary-comprehension","tags":[],"type":"text","url":"/docs/phase-5/dictionary-comprehension","content":"This is one of the cases where Python is noticeably more ergonomic than JS/TS. It also\nsupports the same `if` filter as a list comprehension:","locale":"en"},"454":{"id":"/docs/phase-5/enumerate","page_id":"/docs/phase-5/enumerate","type":"page","content":"enumerate","breadcrumbs":["Docs","Python Notes","Phase 5 — Python-specific Features"],"tags":[],"url":"/docs/phase-5/enumerate","locale":"en"},"455":{"id":"/docs/phase-5/enumerate-0","page_id":"/docs/phase-5/enumerate","tags":[],"type":"text","url":"/docs/phase-5/enumerate","content":"Loop over a list while also getting the index","locale":"en"},"456":{"id":"/docs/phase-5/enumerate-1","page_id":"/docs/phase-5/enumerate","type":"heading","tags":[],"url":"/docs/phase-5/enumerate#starting-from-a-different-number","content":"Starting from a different number","locale":"en"},"457":{"id":"/docs/phase-5/enumerate-2","page_id":"/docs/phase-5/enumerate","tags":[],"type":"text","url":"/docs/phase-5/enumerate","content":"`enumerate()` wraps an iterable so each loop turn gives you both the **index** and the\n**value**.","locale":"en"},"458":{"id":"/docs/phase-5/enumerate-3","page_id":"/docs/phase-5/enumerate","tags":[],"type":"text","url":"/docs/phase-5/enumerate","content":"JS has a couple of ways to get the same result:","locale":"en"},"459":{"id":"/docs/phase-5/enumerate-4","page_id":"/docs/phase-5/enumerate","tags":[],"type":"text","url":"/docs/phase-5/enumerate","content":"`arr.entries()` is the closest match — it also gives you `[index, value]` pairs, same shape\nas Python's `enumerate()`.","locale":"en"},"460":{"id":"/docs/phase-5/enumerate-5","page_id":"/docs/phase-5/enumerate","tags":[],"type":"text","url":"/docs/phase-5/enumerate#starting-from-a-different-number","content":"Pass `start` if you don't want to begin counting at `0`:","locale":"en"},"461":{"id":"/docs/phase-5","page_id":"/docs/phase-5","type":"page","content":"Phase 5 — Python-specific Features","breadcrumbs":["Docs","Python Notes","Phase 5 — Python-specific Features"],"tags":[],"url":"/docs/phase-5","locale":"en"},"462":{"id":"/docs/phase-5-0","page_id":"/docs/phase-5","tags":[],"type":"text","url":"/docs/phase-5","content":"Goals for this phase, and a full JS/TS → Python cheat sheet","locale":"en"},"463":{"id":"/docs/phase-5-1","page_id":"/docs/phase-5","type":"heading","tags":[],"url":"/docs/phase-5#goals","content":"Goals","locale":"en"},"464":{"id":"/docs/phase-5-2","page_id":"/docs/phase-5","type":"heading","tags":[],"url":"/docs/phase-5#cheat-sheet","content":"Cheat sheet","locale":"en"},"465":{"id":"/docs/phase-5-3","page_id":"/docs/phase-5","tags":[],"type":"text","url":"/docs/phase-5","content":"Estimated time: **\\~1.5 hours**.","locale":"en"},"466":{"id":"/docs/phase-5-4","page_id":"/docs/phase-5","tags":[],"type":"text","url":"/docs/phase-5","content":"These don't have a clean JS/TS equivalent, but you'll see them constantly in real Python\ncode. Don't spend hours perfecting them — the goal is just to become **comfortable reading**\nthem.","locale":"en"},"467":{"id":"/docs/phase-5-5","page_id":"/docs/phase-5","tags":[],"type":"text","url":"/docs/phase-5#goals","content":"By the end of this phase you should be comfortable reading:","locale":"en"},"468":{"id":"/docs/phase-5-6","page_id":"/docs/phase-5","tags":[],"type":"text","url":"/docs/phase-5#goals","content":"list comprehension","locale":"en"},"469":{"id":"/docs/phase-5-7","page_id":"/docs/phase-5","tags":[],"type":"text","url":"/docs/phase-5#goals","content":"dictionary comprehension","locale":"en"},"470":{"id":"/docs/phase-5-8","page_id":"/docs/phase-5","tags":[],"type":"text","url":"/docs/phase-5#goals","content":"`enumerate`","locale":"en"},"471":{"id":"/docs/phase-5-9","page_id":"/docs/phase-5","tags":[],"type":"text","url":"/docs/phase-5#goals","content":"`zip`","locale":"en"},"472":{"id":"/docs/phase-5-10","page_id":"/docs/phase-5","tags":[],"type":"text","url":"/docs/phase-5#goals","content":"Each topic is its own page in the sidebar, taught with a JS/TS → Python comparison, followed\nby a small example.","locale":"en"},"473":{"id":"/docs/phase-5/list-comprehension","page_id":"/docs/phase-5/list-comprehension","type":"page","content":"List Comprehension","breadcrumbs":["Docs","Python Notes","Phase 5 — Python-specific Features"],"tags":[],"url":"/docs/phase-5/list-comprehension","locale":"en"},"474":{"id":"/docs/phase-5/list-comprehension-0","page_id":"/docs/phase-5/list-comprehension","tags":[],"type":"text","url":"/docs/phase-5/list-comprehension","content":"A one-line way to build a list — Python's version of .map() and .filter()","locale":"en"},"475":{"id":"/docs/phase-5/list-comprehension-1","page_id":"/docs/phase-5/list-comprehension","type":"heading","tags":[],"url":"/docs/phase-5/list-comprehension#with-a-condition","content":"With a condition","locale":"en"},"476":{"id":"/docs/phase-5/list-comprehension-2","page_id":"/docs/phase-5/list-comprehension","tags":[],"type":"text","url":"/docs/phase-5/list-comprehension","content":"A list comprehension builds a new list from an existing iterable, in a single line.","locale":"en"},"477":{"id":"/docs/phase-5/list-comprehension-3","page_id":"/docs/phase-5/list-comprehension","tags":[],"type":"text","url":"/docs/phase-5/list-comprehension","content":"JavaScript:","locale":"en"},"478":{"id":"/docs/phase-5/list-comprehension-4","page_id":"/docs/phase-5/list-comprehension","tags":[],"type":"text","url":"/docs/phase-5/list-comprehension","content":"Python:","locale":"en"},"479":{"id":"/docs/phase-5/list-comprehension-5","page_id":"/docs/phase-5/list-comprehension","tags":[],"type":"text","url":"/docs/phase-5/list-comprehension","content":"Read it as: &#x2A;*\"`x * x`, for every `x` in `numbers`\"**. The general shape is:","locale":"en"},"480":{"id":"/docs/phase-5/list-comprehension-6","page_id":"/docs/phase-5/list-comprehension","tags":[],"type":"text","url":"/docs/phase-5/list-comprehension","content":"Same idea as `.map()`, just written as one expression instead of a callback.","locale":"en"},"481":{"id":"/docs/phase-5/list-comprehension-7","page_id":"/docs/phase-5/list-comprehension","tags":[],"type":"text","url":"/docs/phase-5/list-comprehension#with-a-condition","content":"Add `if` at the end to filter values as you go — combining what `.filter().map()` would take\ntwo steps to do in JS:","locale":"en"},"482":{"id":"/docs/phase-5/list-comprehension-8","page_id":"/docs/phase-5/list-comprehension","tags":[],"type":"text","url":"/docs/phase-5/list-comprehension#with-a-condition","content":"You'll see this shape constantly once you start reading real Python code — it looks unusual\nat first, but it's just a compact `for` loop that builds a list.","locale":"en"},"483":{"id":"/docs/phase-5/zip","page_id":"/docs/phase-5/zip","type":"page","content":"zip","breadcrumbs":["Docs","Python Notes","Phase 5 — Python-specific Features"],"tags":[],"url":"/docs/phase-5/zip","locale":"en"},"484":{"id":"/docs/phase-5/zip-0","page_id":"/docs/phase-5/zip","tags":[],"type":"text","url":"/docs/phase-5/zip","content":"Loop over two lists together, pair by pair","locale":"en"},"485":{"id":"/docs/phase-5/zip-1","page_id":"/docs/phase-5/zip","type":"heading","tags":[],"url":"/docs/phase-5/zip#uneven-lengths","content":"Uneven lengths","locale":"en"},"486":{"id":"/docs/phase-5/zip-2","page_id":"/docs/phase-5/zip","tags":[],"type":"text","url":"/docs/phase-5/zip","content":"`zip()` pairs up items from two (or more) lists by position, so you can loop over them\ntogether.","locale":"en"},"487":{"id":"/docs/phase-5/zip-3","page_id":"/docs/phase-5/zip","tags":[],"type":"text","url":"/docs/phase-5/zip","content":"JS/TS has no built-in equivalent — you'd normally loop by index instead:","locale":"en"},"488":{"id":"/docs/phase-5/zip-4","page_id":"/docs/phase-5/zip","tags":[],"type":"text","url":"/docs/phase-5/zip","content":"`zip()` reads more directly (\"loop over these two lists together\") instead of managing an\nindex manually.","locale":"en"},"489":{"id":"/docs/phase-5/zip-5","page_id":"/docs/phase-5/zip","tags":[],"type":"text","url":"/docs/phase-5/zip#uneven-lengths","content":"If the lists aren't the same length, `zip()` just stops at the **shorter** one — it doesn't\nraise an error:","locale":"en"},"490":{"id":"/docs/phase-6","page_id":"/docs/phase-6","type":"page","content":"Phase 6 — Exceptions + Modules","breadcrumbs":["Docs","Python Notes","Phase 6 — Exceptions + Modules"],"tags":[],"url":"/docs/phase-6","locale":"en"},"491":{"id":"/docs/phase-6-0","page_id":"/docs/phase-6","tags":[],"type":"text","url":"/docs/phase-6","content":"Goals for this phase, and a full JS/TS → Python cheat sheet","locale":"en"},"492":{"id":"/docs/phase-6-1","page_id":"/docs/phase-6","type":"heading","tags":[],"url":"/docs/phase-6#goals","content":"Goals","locale":"en"},"493":{"id":"/docs/phase-6-2","page_id":"/docs/phase-6","type":"heading","tags":[],"url":"/docs/phase-6#cheat-sheet","content":"Cheat sheet","locale":"en"},"494":{"id":"/docs/phase-6-3","page_id":"/docs/phase-6","tags":[],"type":"text","url":"/docs/phase-6","content":"Estimated time: **\\~1 hour**.","locale":"en"},"495":{"id":"/docs/phase-6-4","page_id":"/docs/phase-6","tags":[],"type":"text","url":"/docs/phase-6#goals","content":"By the end of this phase you should understand:","locale":"en"},"496":{"id":"/docs/phase-6-5","page_id":"/docs/phase-6","tags":[],"type":"text","url":"/docs/phase-6#goals","content":"`try` / `except`","locale":"en"},"497":{"id":"/docs/phase-6-6","page_id":"/docs/phase-6","tags":[],"type":"text","url":"/docs/phase-6#goals","content":"`raise`","locale":"en"},"498":{"id":"/docs/phase-6-7","page_id":"/docs/phase-6","tags":[],"type":"text","url":"/docs/phase-6#goals","content":"modules — `import`, `from ... import ...`","locale":"en"},"499":{"id":"/docs/phase-6-8","page_id":"/docs/phase-6","tags":[],"type":"text","url":"/docs/phase-6#goals","content":"how files and modules relate to each other","locale":"en"},"500":{"id":"/docs/phase-6-9","page_id":"/docs/phase-6","tags":[],"type":"text","url":"/docs/phase-6#goals","content":"Each topic is its own page in the sidebar, taught with a JS/TS → Python comparison, followed\nby a small example.","locale":"en"},"501":{"id":"/docs/phase-6/modules-and-imports","page_id":"/docs/phase-6/modules-and-imports","type":"page","content":"Modules & Imports","breadcrumbs":["Docs","Python Notes","Phase 6 — Exceptions + Modules"],"tags":[],"url":"/docs/phase-6/modules-and-imports","locale":"en"},"502":{"id":"/docs/phase-6/modules-and-imports-0","page_id":"/docs/phase-6/modules-and-imports","tags":[],"type":"text","url":"/docs/phase-6/modules-and-imports","content":"How Python files talk to each other — no export keyword needed","locale":"en"},"503":{"id":"/docs/phase-6/modules-and-imports-1","page_id":"/docs/phase-6/modules-and-imports","type":"heading","tags":[],"url":"/docs/phase-6/modules-and-imports#every-file-is-a-module","content":"Every file is a module","locale":"en"},"504":{"id":"/docs/phase-6/modules-and-imports-2","page_id":"/docs/phase-6/modules-and-imports","type":"heading","tags":[],"url":"/docs/phase-6/modules-and-imports#two-ways-to-import","content":"Two ways to import","locale":"en"},"505":{"id":"/docs/phase-6/modules-and-imports-3","page_id":"/docs/phase-6/modules-and-imports","type":"heading","tags":[],"url":"/docs/phase-6/modules-and-imports#private-by-convention-not-enforcement","content":"\"Private\" by convention, not enforcement","locale":"en"},"506":{"id":"/docs/phase-6/modules-and-imports-4","page_id":"/docs/phase-6/modules-and-imports","tags":[],"type":"text","url":"/docs/phase-6/modules-and-imports#every-file-is-a-module","content":"In JS/TS, a file only shares something if you explicitly `export` it:","locale":"en"},"507":{"id":"/docs/phase-6/modules-and-imports-5","page_id":"/docs/phase-6/modules-and-imports","tags":[],"type":"text","url":"/docs/phase-6/modules-and-imports#every-file-is-a-module","content":"In Python, **every `.py` file is automatically a module** — anything defined at the top\nlevel (functions, classes, variables) can be imported by another file, with no `export`\nkeyword at all:","locale":"en"},"508":{"id":"/docs/phase-6/modules-and-imports-6","page_id":"/docs/phase-6/modules-and-imports","tags":[],"type":"text","url":"/docs/phase-6/modules-and-imports#every-file-is-a-module","content":"The module's name is just the filename without `.py` — `users.py` becomes the module\n`users`.","locale":"en"},"509":{"id":"/docs/phase-6/modules-and-imports-7","page_id":"/docs/phase-6/modules-and-imports","tags":[],"type":"text","url":"/docs/phase-6/modules-and-imports#two-ways-to-import","content":"**Import a specific name** — use it directly, no prefix:","locale":"en"},"510":{"id":"/docs/phase-6/modules-and-imports-8","page_id":"/docs/phase-6/modules-and-imports","tags":[],"type":"text","url":"/docs/phase-6/modules-and-imports#two-ways-to-import","content":"**Import the whole module** — access everything through its name:","locale":"en"},"511":{"id":"/docs/phase-6/modules-and-imports-9","page_id":"/docs/phase-6/modules-and-imports","tags":[],"type":"text","url":"/docs/phase-6/modules-and-imports#two-ways-to-import","content":"This second style maps to JS's namespace import:","locale":"en"},"512":{"id":"/docs/phase-6/modules-and-imports-10","page_id":"/docs/phase-6/modules-and-imports","tags":[],"type":"text","url":"/docs/phase-6/modules-and-imports#two-ways-to-import","content":"`json` here is one of Python's **built-in modules** — it ships with Python itself, no install\nneeded (similar to Node's built-in `fs` or `path`).","locale":"en"},"513":{"id":"/docs/phase-6/modules-and-imports-11","page_id":"/docs/phase-6/modules-and-imports","tags":[],"type":"text","url":"/docs/phase-6/modules-and-imports#private-by-convention-not-enforcement","content":"A name starting with an underscore (`_helper`) is a signal that it's internal and not meant\nto be imported elsewhere — but like the `MAX_USERS` constant convention from Phase 1, Python\ndoesn't actually stop you from importing it. It's a convention other developers rely on, not\na hard rule.","locale":"en"},"514":{"id":"/docs/phase-6/raise","page_id":"/docs/phase-6/raise","type":"page","content":"raise","breadcrumbs":["Docs","Python Notes","Phase 6 — Exceptions + Modules"],"tags":[],"url":"/docs/phase-6/raise","locale":"en"},"515":{"id":"/docs/phase-6/raise-0","page_id":"/docs/phase-6/raise","tags":[],"type":"text","url":"/docs/phase-6/raise","content":"Python's throw — with built-in exception types instead of a generic Error","locale":"en"},"516":{"id":"/docs/phase-6/raise-1","page_id":"/docs/phase-6/raise","type":"heading","tags":[],"url":"/docs/phase-6/raise#built-in-exception-types-instead-of-one-generic-error","content":"Built-in exception types instead of one generic Error","locale":"en"},"517":{"id":"/docs/phase-6/raise-2","page_id":"/docs/phase-6/raise","type":"heading","tags":[],"url":"/docs/phase-6/raise#catching-what-you-raised","content":"Catching what you raised","locale":"en"},"518":{"id":"/docs/phase-6/raise-3","page_id":"/docs/phase-6/raise","tags":[],"type":"text","url":"/docs/phase-6/raise","content":"`raise` is Python's `throw` — it stops the current code and hands control to the nearest\nmatching `except`.","locale":"en"},"519":{"id":"/docs/phase-6/raise-4","page_id":"/docs/phase-6/raise","tags":[],"type":"text","url":"/docs/phase-6/raise","content":"JavaScript:","locale":"en"},"520":{"id":"/docs/phase-6/raise-5","page_id":"/docs/phase-6/raise","tags":[],"type":"text","url":"/docs/phase-6/raise","content":"Python:","locale":"en"},"521":{"id":"/docs/phase-6/raise-6","page_id":"/docs/phase-6/raise","tags":[],"type":"text","url":"/docs/phase-6/raise#built-in-exception-types-instead-of-one-generic-error","content":"JS mostly gives you one `Error` class and you distinguish errors by their message or a custom\nsubclass. Python instead has several **built-in exception types** for common situations, and\nyou pick the one that matches:","locale":"en"},"522":{"id":"/docs/phase-6/raise-7","page_id":"/docs/phase-6/raise","tags":[],"type":"text","url":"/docs/phase-6/raise#built-in-exception-types-instead-of-one-generic-error","content":"This is exactly why the previous page taught you to catch specific exception types — they're\nthe same names on both sides of `raise` and `except`.","locale":"en"},"523":{"id":"/docs/phase-6/raise-8","page_id":"/docs/phase-6/raise","tags":[],"type":"text","url":"/docs/phase-6/raise#catching-what-you-raised","content":"Same pattern as JS:","locale":"en"},"524":{"id":"/docs/phase-6/try-except","page_id":"/docs/phase-6/try-except","type":"page","content":"try / except","breadcrumbs":["Docs","Python Notes","Phase 6 — Exceptions + Modules"],"tags":[],"url":"/docs/phase-6/try-except","locale":"en"},"525":{"id":"/docs/phase-6/try-except-0","page_id":"/docs/phase-6/try-except","tags":[],"type":"text","url":"/docs/phase-6/try-except","content":"Python's try/catch — but it wants you to name the specific error","locale":"en"},"526":{"id":"/docs/phase-6/try-except-1","page_id":"/docs/phase-6/try-except","type":"heading","tags":[],"url":"/docs/phase-6/try-except#the-basic-shape","content":"The basic shape","locale":"en"},"527":{"id":"/docs/phase-6/try-except-2","page_id":"/docs/phase-6/try-except","type":"heading","tags":[],"url":"/docs/phase-6/try-except#catch-specific-errors-not-everything","content":"Catch specific errors, not everything","locale":"en"},"528":{"id":"/docs/phase-6/try-except-3","page_id":"/docs/phase-6/try-except","type":"heading","tags":[],"url":"/docs/phase-6/try-except#finally","content":"finally","locale":"en"},"529":{"id":"/docs/phase-6/try-except-4","page_id":"/docs/phase-6/try-except","tags":[],"type":"text","url":"/docs/phase-6/try-except#the-basic-shape","content":"JavaScript:","locale":"en"},"530":{"id":"/docs/phase-6/try-except-5","page_id":"/docs/phase-6/try-except","tags":[],"type":"text","url":"/docs/phase-6/try-except#the-basic-shape","content":"Python:","locale":"en"},"531":{"id":"/docs/phase-6/try-except-6","page_id":"/docs/phase-6/try-except","tags":[],"type":"text","url":"/docs/phase-6/try-except#the-basic-shape","content":"`except` is Python's `catch`. The rest reads the same: code that might fail goes in the first\nblock, recovery logic goes in the second.","locale":"en"},"532":{"id":"/docs/phase-6/try-except-7","page_id":"/docs/phase-6/try-except","tags":[],"type":"text","url":"/docs/phase-6/try-except#the-basic-shape","content":"**A gotcha coming from JS:** `10 / 0` in JavaScript doesn't throw — it quietly gives you\n`Infinity`. In Python, dividing by zero **raises an exception**. Different languages, different\nrules for what counts as an error.","locale":"en"},"533":{"id":"/docs/phase-6/try-except-8","page_id":"/docs/phase-6/try-except","tags":[],"type":"text","url":"/docs/phase-6/try-except#catch-specific-errors-not-everything","content":"JS's `catch (error)` catches anything, no questions asked. Python encourages you to name the\n**specific exception type** you expect, like `ZeroDivisionError` above. Common built-in ones\nyou'll run into:","locale":"en"},"534":{"id":"/docs/phase-6/try-except-9","page_id":"/docs/phase-6/try-except","tags":[],"type":"text","url":"/docs/phase-6/try-except#catch-specific-errors-not-everything","content":"You can still catch broadly with `except Exception`, and read the message via `str(e)` —\nsimilar to reading `error.message` in JS:","locale":"en"},"535":{"id":"/docs/phase-6/try-except-10","page_id":"/docs/phase-6/try-except","tags":[],"type":"text","url":"/docs/phase-6/try-except#catch-specific-errors-not-everything","content":"Prefer naming the specific exception when you know what you're guarding against — it's the\nidiomatic Python style, and it stops you from accidentally swallowing an unrelated bug.","locale":"en"},"536":{"id":"/docs/phase-6/try-except-11","page_id":"/docs/phase-6/try-except","tags":[],"type":"text","url":"/docs/phase-6/try-except#finally","content":"Just like JS, `finally` always runs, whether or not an exception happened:","locale":"en"},"537":{"id":"/docs/phase-7/container-hints","page_id":"/docs/phase-7/container-hints","type":"page","content":"Container Hints","breadcrumbs":["Docs","Python Notes","Phase 7 — Type Hints"],"tags":[],"url":"/docs/phase-7/container-hints","locale":"en"},"538":{"id":"/docs/phase-7/container-hints-0","page_id":"/docs/phase-7/container-hints","tags":[],"type":"text","url":"/docs/phase-7/container-hints","content":"Describing what's inside a list or dict, not just that it is one","locale":"en"},"539":{"id":"/docs/phase-7/container-hints-1","page_id":"/docs/phase-7/container-hints","type":"heading","tags":[],"url":"/docs/phase-7/container-hints#list","content":"list[...]","locale":"en"},"540":{"id":"/docs/phase-7/container-hints-2","page_id":"/docs/phase-7/container-hints","type":"heading","tags":[],"url":"/docs/phase-7/container-hints#dict","content":"dict[...]","locale":"en"},"541":{"id":"/docs/phase-7/container-hints-3","page_id":"/docs/phase-7/container-hints","tags":[],"type":"text","url":"/docs/phase-7/container-hints","content":"So far the type hints have described a single value. Containers need one more piece of\ninformation: **what's inside them**.","locale":"en"},"542":{"id":"/docs/phase-7/container-hints-4","page_id":"/docs/phase-7/container-hints","tags":[],"type":"text","url":"/docs/phase-7/container-hints#list","content":"TypeScript:","locale":"en"},"543":{"id":"/docs/phase-7/container-hints-5","page_id":"/docs/phase-7/container-hints","tags":[],"type":"text","url":"/docs/phase-7/container-hints#list","content":"Python:","locale":"en"},"544":{"id":"/docs/phase-7/container-hints-6","page_id":"/docs/phase-7/container-hints","tags":[],"type":"text","url":"/docs/phase-7/container-hints#list","content":"`list[str]` reads as \"a list, of strings\" — the type inside the brackets describes every\nitem in the list.","locale":"en"},"545":{"id":"/docs/phase-7/container-hints-7","page_id":"/docs/phase-7/container-hints","tags":[],"type":"text","url":"/docs/phase-7/container-hints#dict","content":"TypeScript's closest match is `Record<KeyType, ValueType>`:","locale":"en"},"546":{"id":"/docs/phase-7/container-hints-8","page_id":"/docs/phase-7/container-hints","tags":[],"type":"text","url":"/docs/phase-7/container-hints#dict","content":"Python:","locale":"en"},"547":{"id":"/docs/phase-7/container-hints-9","page_id":"/docs/phase-7/container-hints","tags":[],"type":"text","url":"/docs/phase-7/container-hints#dict","content":"The general shape is `dict[KeyType, ValueType]` — key type first, value type second, in that\norder.","locale":"en"},"548":{"id":"/docs/phase-7/container-hints-10","page_id":"/docs/phase-7/container-hints","tags":[],"type":"text","url":"/docs/phase-7/container-hints#dict","content":"Keep this reading habit — it's the same pattern you'll use to build up the nested types on\nthe next page.","locale":"en"},"549":{"id":"/docs/phase-7","page_id":"/docs/phase-7","type":"page","content":"Phase 7 — Type Hints","breadcrumbs":["Docs","Python Notes","Phase 7 — Type Hints"],"tags":[],"url":"/docs/phase-7","locale":"en"},"550":{"id":"/docs/phase-7-0","page_id":"/docs/phase-7","tags":[],"type":"text","url":"/docs/phase-7","content":"Goals for this phase, and a full TypeScript → Python cheat sheet","locale":"en"},"551":{"id":"/docs/phase-7-1","page_id":"/docs/phase-7","type":"heading","tags":[],"url":"/docs/phase-7#goals","content":"Goals","locale":"en"},"552":{"id":"/docs/phase-7-2","page_id":"/docs/phase-7","type":"heading","tags":[],"url":"/docs/phase-7#cheat-sheet","content":"Cheat sheet","locale":"en"},"553":{"id":"/docs/phase-7-3","page_id":"/docs/phase-7","tags":[],"type":"text","url":"/docs/phase-7","content":"Estimated time: **\\~1 hour**. ⭐⭐⭐","locale":"en"},"554":{"id":"/docs/phase-7-4","page_id":"/docs/phase-7","tags":[],"type":"text","url":"/docs/phase-7","content":"Spend real time here — from tomorrow onward you'll see type hints on almost every function\nand data model you touch, especially with FastAPI.","locale":"en"},"555":{"id":"/docs/phase-7-5","page_id":"/docs/phase-7","tags":[],"type":"text","url":"/docs/phase-7","content":"Phase 3 already introduced type hints on function parameters and return values. This phase\ngoes wider: annotating plain variables, and describing the **shape** of containers like\nlists and dicts — not just \"it's a list\", but \"a list of what\".","locale":"en"},"556":{"id":"/docs/phase-7-6","page_id":"/docs/phase-7","tags":[],"type":"text","url":"/docs/phase-7#goals","content":"By the end of this phase you should be comfortable reading and writing:","locale":"en"},"557":{"id":"/docs/phase-7-7","page_id":"/docs/phase-7","tags":[],"type":"text","url":"/docs/phase-7#goals","content":"Don't worry about anything more advanced than this yet — generics, `Protocol`, `Callable`,\nand so on can wait until you actually need them.","locale":"en"},"558":{"id":"/docs/phase-7/optional-and-nested","page_id":"/docs/phase-7/optional-and-nested","type":"page","content":"Optional & Nested Types","breadcrumbs":["Docs","Python Notes","Phase 7 — Type Hints"],"tags":[],"url":"/docs/phase-7/optional-and-nested","locale":"en"},"559":{"id":"/docs/phase-7/optional-and-nested-0","page_id":"/docs/phase-7/optional-and-nested","tags":[],"type":"text","url":"/docs/phase-7/optional-and-nested","content":"A value that might be None, and combining container hints together","locale":"en"},"560":{"id":"/docs/phase-7/optional-and-nested-1","page_id":"/docs/phase-7/optional-and-nested","type":"heading","tags":[],"url":"/docs/phase-7/optional-and-nested#optional--a-value-that-might-be-none","content":"Optional — a value that might be None","locale":"en"},"561":{"id":"/docs/phase-7/optional-and-nested-2","page_id":"/docs/phase-7/optional-and-nested","type":"heading","tags":[],"url":"/docs/phase-7/optional-and-nested#nested-types","content":"Nested types","locale":"en"},"562":{"id":"/docs/phase-7/optional-and-nested-3","page_id":"/docs/phase-7/optional-and-nested","type":"heading","tags":[],"url":"/docs/phase-7/optional-and-nested#thats-enough-for-now","content":"That's enough for now","locale":"en"},"563":{"id":"/docs/phase-7/optional-and-nested-4","page_id":"/docs/phase-7/optional-and-nested","tags":[],"type":"text","url":"/docs/phase-7/optional-and-nested#optional--a-value-that-might-be-none","content":"You saw this briefly in Phase 3. `| None` marks a value as optional:","locale":"en"},"564":{"id":"/docs/phase-7/optional-and-nested-5","page_id":"/docs/phase-7/optional-and-nested","tags":[],"type":"text","url":"/docs/phase-7/optional-and-nested#optional--a-value-that-might-be-none","content":"TypeScript:","locale":"en"},"565":{"id":"/docs/phase-7/optional-and-nested-6","page_id":"/docs/phase-7/optional-and-nested","tags":[],"type":"text","url":"/docs/phase-7/optional-and-nested#optional--a-value-that-might-be-none","content":"Read `str | None` as \"a string, or `None`\" — same union-type idea as TypeScript's\n`string | null`, just with Python's own \"no value\" (Phase 1) instead of `null`.","locale":"en"},"566":{"id":"/docs/phase-7/optional-and-nested-7","page_id":"/docs/phase-7/optional-and-nested","tags":[],"type":"text","url":"/docs/phase-7/optional-and-nested#optional--a-value-that-might-be-none","content":"This shows up constantly on function parameters that have a sensible default of \"nothing\nprovided\":","locale":"en"},"567":{"id":"/docs/phase-7/optional-and-nested-8","page_id":"/docs/phase-7/optional-and-nested","tags":[],"type":"text","url":"/docs/phase-7/optional-and-nested#nested-types","content":"Container hints can be combined — a list of dicts, a dict of lists, and so on. Read them\n**inside-out**: figure out the innermost type first, then wrap outward.","locale":"en"},"568":{"id":"/docs/phase-7/optional-and-nested-9","page_id":"/docs/phase-7/optional-and-nested","tags":[],"type":"text","url":"/docs/phase-7/optional-and-nested#nested-types","content":"Reading inside-out:","locale":"en"},"569":{"id":"/docs/phase-7/optional-and-nested-10","page_id":"/docs/phase-7/optional-and-nested","tags":[],"type":"text","url":"/docs/phase-7/optional-and-nested#nested-types","content":"`dict[str, str]` — a dict where both the keys and values are strings","locale":"en"},"570":{"id":"/docs/phase-7/optional-and-nested-11","page_id":"/docs/phase-7/optional-and-nested","tags":[],"type":"text","url":"/docs/phase-7/optional-and-nested#nested-types","content":"`list[...]` — a list of those dicts","locale":"en"},"571":{"id":"/docs/phase-7/optional-and-nested-12","page_id":"/docs/phase-7/optional-and-nested","tags":[],"type":"text","url":"/docs/phase-7/optional-and-nested#nested-types","content":"So the whole thing means: &#x2A;*\"a list, where each item is a dict of string to string.\"**","locale":"en"},"572":{"id":"/docs/phase-7/optional-and-nested-13","page_id":"/docs/phase-7/optional-and-nested","tags":[],"type":"text","url":"/docs/phase-7/optional-and-nested#nested-types","content":"TypeScript:","locale":"en"},"573":{"id":"/docs/phase-7/optional-and-nested-14","page_id":"/docs/phase-7/optional-and-nested","tags":[],"type":"text","url":"/docs/phase-7/optional-and-nested#nested-types","content":"You'll see this exact shape constantly — a list of dicts is how most APIs represent \"many\nrecords\", each record being one dict (Phase 2's nested-data example, now with hints on it).","locale":"en"},"574":{"id":"/docs/phase-7/optional-and-nested-15","page_id":"/docs/phase-7/optional-and-nested","tags":[],"type":"text","url":"/docs/phase-7/optional-and-nested#thats-enough-for-now","content":"`str | None`, `list[...]`, and `dict[...]` cover the vast majority of type hints you'll write\nday to day. Things like generics, `Protocol`, or `Callable` types are worth learning later,\nonce you actually hit a case that needs them — not before.","locale":"en"},"575":{"id":"/docs/phase-7/variable-and-function-hints","page_id":"/docs/phase-7/variable-and-function-hints","type":"page","content":"Variable & Function Hints","breadcrumbs":["Docs","Python Notes","Phase 7 — Type Hints"],"tags":[],"url":"/docs/phase-7/variable-and-function-hints","locale":"en"},"576":{"id":"/docs/phase-7/variable-and-function-hints-0","page_id":"/docs/phase-7/variable-and-function-hints","tags":[],"type":"text","url":"/docs/phase-7/variable-and-function-hints","content":"Annotating plain values, and a recap of function type hints","locale":"en"},"577":{"id":"/docs/phase-7/variable-and-function-hints-1","page_id":"/docs/phase-7/variable-and-function-hints","type":"heading","tags":[],"url":"/docs/phase-7/variable-and-function-hints#variable-type-hints","content":"Variable type hints","locale":"en"},"578":{"id":"/docs/phase-7/variable-and-function-hints-2","page_id":"/docs/phase-7/variable-and-function-hints","type":"heading","tags":[],"url":"/docs/phase-7/variable-and-function-hints#function-hints--a-recap","content":"Function hints — a recap","locale":"en"},"579":{"id":"/docs/phase-7/variable-and-function-hints-3","page_id":"/docs/phase-7/variable-and-function-hints","tags":[],"type":"text","url":"/docs/phase-7/variable-and-function-hints#variable-type-hints","content":"TypeScript:","locale":"en"},"580":{"id":"/docs/phase-7/variable-and-function-hints-4","page_id":"/docs/phase-7/variable-and-function-hints","tags":[],"type":"text","url":"/docs/phase-7/variable-and-function-hints#variable-type-hints","content":"Python:","locale":"en"},"581":{"id":"/docs/phase-7/variable-and-function-hints-5","page_id":"/docs/phase-7/variable-and-function-hints","tags":[],"type":"text","url":"/docs/phase-7/variable-and-function-hints#variable-type-hints","content":"Same idea as TypeScript — `name: type`. You saw these exact four types back in Phase 1\nwithout the annotation; now you're just labeling them explicitly.","locale":"en"},"582":{"id":"/docs/phase-7/variable-and-function-hints-6","page_id":"/docs/phase-7/variable-and-function-hints","tags":[],"type":"text","url":"/docs/phase-7/variable-and-function-hints#variable-type-hints","content":"You can also annotate a variable **without** giving it a value yet — this is common in\nplaces like class bodies (Phase 4) and data models, where you're describing a shape rather\nthan assigning something right away:","locale":"en"},"583":{"id":"/docs/phase-7/variable-and-function-hints-7","page_id":"/docs/phase-7/variable-and-function-hints","tags":[],"type":"text","url":"/docs/phase-7/variable-and-function-hints#function-hints--a-recap","content":"Phase 3 already covered this, so this is just a reminder of the shape, now that you've seen\nthe plain-variable version too:","locale":"en"},"584":{"id":"/docs/phase-7/variable-and-function-hints-8","page_id":"/docs/phase-7/variable-and-function-hints","tags":[],"type":"text","url":"/docs/phase-7/variable-and-function-hints#function-hints--a-recap","content":"`user_id: int` is a parameter hint (same as a variable hint), and `-> dict` is the return\ntype — exactly like the return type after `:` in TypeScript.","locale":"en"},"585":{"id":"/docs/phase-7/variable-and-function-hints-9","page_id":"/docs/phase-7/variable-and-function-hints","tags":[],"type":"text","url":"/docs/phase-7/variable-and-function-hints#function-hints--a-recap","content":"As a reminder from Phase 3: none of this is enforced by Python itself. It's the frameworks\nyou build with — FastAPI especially — that actually read these hints and act on them.","locale":"en"},"586":{"id":"/docs/phase-8/async-and-await","page_id":"/docs/phase-8/async-and-await","type":"page","content":"def, async def & await","breadcrumbs":["Docs","Python Notes","Phase 8 — async / await"],"tags":[],"url":"/docs/phase-8/async-and-await","locale":"en"},"587":{"id":"/docs/phase-8/async-and-await-0","page_id":"/docs/phase-8/async-and-await","tags":[],"type":"text","url":"/docs/phase-8/async-and-await","content":"Same idea as JS async/await — almost the same keywords too","locale":"en"},"588":{"id":"/docs/phase-8/async-and-await-1","page_id":"/docs/phase-8/async-and-await","type":"heading","tags":[],"url":"/docs/phase-8/async-and-await#def-vs-async-def","content":"def vs. async def","locale":"en"},"589":{"id":"/docs/phase-8/async-and-await-2","page_id":"/docs/phase-8/async-and-await","type":"heading","tags":[],"url":"/docs/phase-8/async-and-await#await","content":"await","locale":"en"},"590":{"id":"/docs/phase-8/async-and-await-3","page_id":"/docs/phase-8/async-and-await","type":"heading","tags":[],"url":"/docs/phase-8/async-and-await#a-real-difference-from-js-calling-an-async-function","content":"A real difference from JS: calling an async function","locale":"en"},"591":{"id":"/docs/phase-8/async-and-await-4","page_id":"/docs/phase-8/async-and-await","tags":[],"type":"text","url":"/docs/phase-8/async-and-await#def-vs-async-def","content":"A normal function runs synchronously, start to finish, exactly like a normal JS function:","locale":"en"},"592":{"id":"/docs/phase-8/async-and-await-5","page_id":"/docs/phase-8/async-and-await","tags":[],"type":"text","url":"/docs/phase-8/async-and-await#def-vs-async-def","content":"Adding `async` before `def` makes it an **asynchronous function** — one that can pause and\nresume, without blocking the rest of the program while it waits:","locale":"en"},"593":{"id":"/docs/phase-8/async-and-await-6","page_id":"/docs/phase-8/async-and-await","tags":[],"type":"text","url":"/docs/phase-8/async-and-await#def-vs-async-def","content":"Same keyword, same idea, just placed before `def` instead of before `function`.","locale":"en"},"594":{"id":"/docs/phase-8/async-and-await-7","page_id":"/docs/phase-8/async-and-await","tags":[],"type":"text","url":"/docs/phase-8/async-and-await#await","content":"Inside an `async def` function, `await` pauses at that line until whatever you're awaiting\nfinishes — then resumes with its result. This is the exact same mental model as JS:","locale":"en"},"595":{"id":"/docs/phase-8/async-and-await-8","page_id":"/docs/phase-8/async-and-await","tags":[],"type":"text","url":"/docs/phase-8/async-and-await#await","content":"Just like JS, `await` can only be used **inside** an `async def` function — not in a regular\none.","locale":"en"},"596":{"id":"/docs/phase-8/async-and-await-9","page_id":"/docs/phase-8/async-and-await","tags":[],"type":"text","url":"/docs/phase-8/async-and-await#a-real-difference-from-js-calling-an-async-function","content":"In JS, calling an async function starts running it immediately, whether or not you `await`\nthe result. In Python, calling an `async def` function does **not** run it at all — it just\ncreates a \"coroutine\" object that sits there, inert, until something actually awaits or\nschedules it:","locale":"en"},"597":{"id":"/docs/phase-8/async-and-await-10","page_id":"/docs/phase-8/async-and-await","tags":[],"type":"text","url":"/docs/phase-8/async-and-await#a-real-difference-from-js-calling-an-async-function","content":"To actually run one at the top level of a plain script, Python needs an event loop:","locale":"en"},"598":{"id":"/docs/phase-8/async-and-await-11","page_id":"/docs/phase-8/async-and-await","tags":[],"type":"text","url":"/docs/phase-8/async-and-await#a-real-difference-from-js-calling-an-async-function","content":"You won't usually write `asyncio.run()` yourself once you're inside a framework — in\nFastAPI, you just write your route handlers as `async def`, and FastAPI's own event loop\nruns them for you. This \"nothing happens until awaited\" behavior is the one habit worth\ninternalizing now, since it's the most common source of confusion moving from JS to Python.","locale":"en"},"599":{"id":"/docs/phase-8","page_id":"/docs/phase-8","type":"page","content":"Phase 8 — async / await","breadcrumbs":["Docs","Python Notes","Phase 8 — async / await"],"tags":[],"url":"/docs/phase-8","locale":"en"},"600":{"id":"/docs/phase-8-0","page_id":"/docs/phase-8","tags":[],"type":"text","url":"/docs/phase-8","content":"Goals for this phase, and a JS/TS → Python cheat sheet","locale":"en"},"601":{"id":"/docs/phase-8-1","page_id":"/docs/phase-8","type":"heading","tags":[],"url":"/docs/phase-8#goals","content":"Goals","locale":"en"},"602":{"id":"/docs/phase-8-2","page_id":"/docs/phase-8","type":"heading","tags":[],"url":"/docs/phase-8#cheat-sheet","content":"Cheat sheet","locale":"en"},"603":{"id":"/docs/phase-8-3","page_id":"/docs/phase-8","tags":[],"type":"text","url":"/docs/phase-8","content":"Estimated time: **\\~45 minutes**. ⭐⭐⭐ — the last thing for today.","locale":"en"},"604":{"id":"/docs/phase-8-4","page_id":"/docs/phase-8","tags":[],"type":"text","url":"/docs/phase-8","content":"You already know this concept from JS — Python's version uses almost identical keywords.","locale":"en"},"605":{"id":"/docs/phase-8-5","page_id":"/docs/phase-8","tags":[],"type":"text","url":"/docs/phase-8#goals","content":"Understand:","locale":"en"},"606":{"id":"/docs/phase-8-6","page_id":"/docs/phase-8","tags":[],"type":"text","url":"/docs/phase-8#goals","content":"`def` — a normal function","locale":"en"},"607":{"id":"/docs/phase-8-7","page_id":"/docs/phase-8","tags":[],"type":"text","url":"/docs/phase-8#goals","content":"`async def` — an asynchronous function","locale":"en"},"608":{"id":"/docs/phase-8-8","page_id":"/docs/phase-8","tags":[],"type":"text","url":"/docs/phase-8#goals","content":"`await` — wait for an async operation to finish","locale":"en"},"609":{"id":"/docs/phase-8-9","page_id":"/docs/phase-8","tags":[],"type":"text","url":"/docs/phase-8#goals","content":"That's genuinely enough for tomorrow — one more page on this, and you're done for today.","locale":"en"},"610":{"id":"/docs/fastapi/getting-started/database-connection","page_id":"/docs/fastapi/getting-started/database-connection","type":"page","content":"Database Connection","breadcrumbs":["Docs","Backend with FastAPI","Getting Started"],"tags":[],"url":"/docs/fastapi/getting-started/database-connection","locale":"en"},"611":{"id":"/docs/fastapi/getting-started/database-connection-0","page_id":"/docs/fastapi/getting-started/database-connection","tags":[],"type":"text","url":"/docs/fastapi/getting-started/database-connection","content":"Turning your connection string into a real connection with SQLAlchemy","locale":"en"},"612":{"id":"/docs/fastapi/getting-started/database-connection-1","page_id":"/docs/fastapi/getting-started/database-connection","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/database-connection#three-pieces-sqlalchemy-needs","content":"Three pieces SQLAlchemy needs","locale":"en"},"613":{"id":"/docs/fastapi/getting-started/database-connection-2","page_id":"/docs/fastapi/getting-started/database-connection","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/database-connection#databasepy","content":"database.py","locale":"en"},"614":{"id":"/docs/fastapi/getting-started/database-connection-3","page_id":"/docs/fastapi/getting-started/database-connection","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/database-connection#walking-through-it","content":"Walking through it","locale":"en"},"615":{"id":"/docs/fastapi/getting-started/database-connection-4","page_id":"/docs/fastapi/getting-started/database-connection","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/database-connection#whats-next","content":"What's next","locale":"en"},"616":{"id":"/docs/fastapi/getting-started/database-connection-5","page_id":"/docs/fastapi/getting-started/database-connection","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/database-connection#databasepy-so-far","content":"`database.py` so far","locale":"en"},"617":{"id":"/docs/fastapi/getting-started/database-connection-6","page_id":"/docs/fastapi/getting-started/database-connection","tags":[],"type":"text","url":"/docs/fastapi/getting-started/database-connection","content":"You have a `DATABASE_URL` sitting in `.env`. Now you need actual code that reads it and\nprepares a connection to the database. This lives in its own file, `database.py` — every\nother file in the project that needs the database will import from here, rather than\nconnecting on its own.","locale":"en"},"618":{"id":"/docs/fastapi/getting-started/database-connection-7","page_id":"/docs/fastapi/getting-started/database-connection","tags":[],"type":"text","url":"/docs/fastapi/getting-started/database-connection#three-pieces-sqlalchemy-needs","content":"Before the code, know what you're building:","locale":"en"},"619":{"id":"/docs/fastapi/getting-started/database-connection-8","page_id":"/docs/fastapi/getting-started/database-connection","tags":[],"type":"text","url":"/docs/fastapi/getting-started/database-connection#three-pieces-sqlalchemy-needs","content":"**Engine** — the actual connection to the database. It knows which database you're talking\nto and manages a pool of connections behind the scenes.","locale":"en"},"620":{"id":"/docs/fastapi/getting-started/database-connection-9","page_id":"/docs/fastapi/getting-started/database-connection","tags":[],"type":"text","url":"/docs/fastapi/getting-started/database-connection#three-pieces-sqlalchemy-needs","content":"**Session** — think of this as one conversation with the database, used to run queries and\nsave changes. You'll create a new one per request, later.","locale":"en"},"621":{"id":"/docs/fastapi/getting-started/database-connection-10","page_id":"/docs/fastapi/getting-started/database-connection","tags":[],"type":"text","url":"/docs/fastapi/getting-started/database-connection#three-pieces-sqlalchemy-needs","content":"**Base** — a base class that every database model (table) you define in a future lesson\nwill inherit from.","locale":"en"},"622":{"id":"/docs/fastapi/getting-started/database-connection-11","page_id":"/docs/fastapi/getting-started/database-connection","tags":[],"type":"text","url":"/docs/fastapi/getting-started/database-connection#walking-through-it","content":"**`load_dotenv()`** reads your `.env` file and makes its values available through\n`os.getenv()` — this must run before you try to read anything from it.","locale":"en"},"623":{"id":"/docs/fastapi/getting-started/database-connection-12","page_id":"/docs/fastapi/getting-started/database-connection","tags":[],"type":"text","url":"/docs/fastapi/getting-started/database-connection#walking-through-it","content":"**`os.getenv(\"DATABASE_URL\")`** reads the exact connection string you set up in the last\nlesson.","locale":"en"},"624":{"id":"/docs/fastapi/getting-started/database-connection-13","page_id":"/docs/fastapi/getting-started/database-connection","tags":[],"type":"text","url":"/docs/fastapi/getting-started/database-connection#walking-through-it","content":"**`create_engine(DATABASE_URL)`** hands that connection string to SQLAlchemy. It parses the\n`mysql://` part and knows to use the MySQL driver (`mysqlclient`, installed back in Project\nSetup) to talk to it. Worth knowing: this line doesn't actually open a connection yet — the\nengine connects lazily, the first time it's actually used.","locale":"en"},"625":{"id":"/docs/fastapi/getting-started/database-connection-14","page_id":"/docs/fastapi/getting-started/database-connection","tags":[],"type":"text","url":"/docs/fastapi/getting-started/database-connection#walking-through-it","content":"**`sessionmaker(bind=engine, autoflush=False)`** doesn't create a session either — it creates\na *factory*, `SessionLocal`, a function you'll call later (`SessionLocal()`) whenever a piece\nof code needs an actual session to run queries with. `bind=engine` ties every session it\ncreates to the engine above; `autoflush=False` means SQLAlchemy won't automatically send\npending changes to the database before every query — you decide when that happens.","locale":"en"},"626":{"id":"/docs/fastapi/getting-started/database-connection-15","page_id":"/docs/fastapi/getting-started/database-connection","tags":[],"type":"text","url":"/docs/fastapi/getting-started/database-connection#walking-through-it","content":"**`declarative_base()`** creates the `Base` class. Every table you define as a Python class in\na future lesson will inherit from this `Base`, which is how SQLAlchemy knows those classes\nrepresent database tables.","locale":"en"},"627":{"id":"/docs/fastapi/getting-started/database-connection-16","page_id":"/docs/fastapi/getting-started/database-connection","tags":[],"type":"text","url":"/docs/fastapi/getting-started/database-connection#whats-next","content":"This file only *prepares* the connection — nothing in your app uses it yet. In a future\nlesson, you'll write a small function that hands out a `SessionLocal()` session to each\nrequest that needs one, and closes it automatically when the request finishes. For now, your\nproject has everything it needs to actually reach the database.","locale":"en"},"628":{"id":"/docs/fastapi/getting-started/database-connection-17","page_id":"/docs/fastapi/getting-started/database-connection","tags":[],"type":"text","url":"/docs/fastapi/getting-started/database-connection#whats-next","content":"This is the same role as setting up a TypeORM `DataSource` or a Prisma `PrismaClient` — one\nshared connection object, created once, that the rest of the app imports and reuses instead\nof opening a new database connection per request. `engine` is the connection itself,\n`SessionLocal` is what you'd call to get a usable client/query-runner, and `Base` plays the\nrole TypeORM's `@Entity()` base or Prisma's generated model types play for your future\ntable classes.","locale":"en"},"629":{"id":"/docs/fastapi/getting-started/environment-configuration","page_id":"/docs/fastapi/getting-started/environment-configuration","type":"page","content":"Environment Configuration","breadcrumbs":["Docs","Backend with FastAPI","Getting Started"],"tags":[],"url":"/docs/fastapi/getting-started/environment-configuration","locale":"en"},"630":{"id":"/docs/fastapi/getting-started/environment-configuration-0","page_id":"/docs/fastapi/getting-started/environment-configuration","tags":[],"type":"text","url":"/docs/fastapi/getting-started/environment-configuration","content":"Keeping database credentials out of your code with a .env file","locale":"en"},"631":{"id":"/docs/fastapi/getting-started/environment-configuration-1","page_id":"/docs/fastapi/getting-started/environment-configuration","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/environment-configuration#environment-variables","content":"Environment variables","locale":"en"},"632":{"id":"/docs/fastapi/getting-started/environment-configuration-2","page_id":"/docs/fastapi/getting-started/environment-configuration","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/environment-configuration#creating-your-env-file","content":"Creating your .env file","locale":"en"},"633":{"id":"/docs/fastapi/getting-started/environment-configuration-3","page_id":"/docs/fastapi/getting-started/environment-configuration","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/environment-configuration#reading-a-connection-string","content":"Reading a connection string","locale":"en"},"634":{"id":"/docs/fastapi/getting-started/environment-configuration-4","page_id":"/docs/fastapi/getting-started/environment-configuration","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/environment-configuration#never-commit-env-to-git","content":"Never commit .env to git","locale":"en"},"635":{"id":"/docs/fastapi/getting-started/environment-configuration-5","page_id":"/docs/fastapi/getting-started/environment-configuration","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/environment-configuration#env-so-far","content":"`.env` so far","locale":"en"},"636":{"id":"/docs/fastapi/getting-started/environment-configuration-6","page_id":"/docs/fastapi/getting-started/environment-configuration","tags":[],"type":"text","url":"/docs/fastapi/getting-started/environment-configuration","content":"Back in Web Fundamentals, you learned that secrets like database credentials must never be\nvisible to a user. There's a second rule that follows from that: they shouldn't be\n**hardcoded directly into your source code** either — code gets committed to git, shared with\nteammates, and pushed to hosting providers, and not everyone who sees your code should see\nyour production database password.","locale":"en"},"637":{"id":"/docs/fastapi/getting-started/environment-configuration-7","page_id":"/docs/fastapi/getting-started/environment-configuration","tags":[],"type":"text","url":"/docs/fastapi/getting-started/environment-configuration#environment-variables","content":"The fix is to keep configuration **outside** your code, as **environment variables** — values\nsupplied to your program at runtime by whatever is running it, rather than written into a\nfile.","locale":"en"},"638":{"id":"/docs/fastapi/getting-started/environment-configuration-8","page_id":"/docs/fastapi/getting-started/environment-configuration","tags":[],"type":"text","url":"/docs/fastapi/getting-started/environment-configuration#environment-variables","content":"In local development, the standard way to manage these is a `.env` file — a plain text file\nof `KEY=VALUE` pairs, sitting in your project root, that your program reads on startup. This\nis exactly what the `python-dotenv` package you installed last lesson is for.","locale":"en"},"639":{"id":"/docs/fastapi/getting-started/environment-configuration-9","page_id":"/docs/fastapi/getting-started/environment-configuration","tags":[],"type":"text","url":"/docs/fastapi/getting-started/environment-configuration#creating-your-env-file","content":"Create a file named `.env` in your project root, and add your database connection string:","locale":"en"},"640":{"id":"/docs/fastapi/getting-started/environment-configuration-10","page_id":"/docs/fastapi/getting-started/environment-configuration","tags":[],"type":"text","url":"/docs/fastapi/getting-started/environment-configuration#reading-a-connection-string","content":"That `DATABASE_URL` value is called a **connection string** — a single line that packs in\neverything needed to reach a specific database. Breaking it apart:","locale":"en"},"641":{"id":"/docs/fastapi/getting-started/environment-configuration-11","page_id":"/docs/fastapi/getting-started/environment-configuration","tags":[],"type":"text","url":"/docs/fastapi/getting-started/environment-configuration#reading-a-connection-string","content":"So this line says: &#x2A;\"connect to a MySQL server running on this machine, on port 3306, log in\nas `app_user` with password `test`, and use the database named `todo`.\"*","locale":"en"},"642":{"id":"/docs/fastapi/getting-started/environment-configuration-12","page_id":"/docs/fastapi/getting-started/environment-configuration","tags":[],"type":"text","url":"/docs/fastapi/getting-started/environment-configuration#never-commit-env-to-git","content":"Your `.env` file contains real credentials — it should **never** be committed to version\ncontrol. Add it to `.gitignore` immediately:","locale":"en"},"643":{"id":"/docs/fastapi/getting-started/environment-configuration-13","page_id":"/docs/fastapi/getting-started/environment-configuration","tags":[],"type":"text","url":"/docs/fastapi/getting-started/environment-configuration#never-commit-env-to-git","content":"Anyone setting up the project fresh creates their own local `.env` with their own database\ndetails — it's part of each developer's local setup, not part of the shared codebase.","locale":"en"},"644":{"id":"/docs/fastapi/getting-started/environment-configuration-14","page_id":"/docs/fastapi/getting-started/environment-configuration","tags":[],"type":"text","url":"/docs/fastapi/getting-started/environment-configuration#never-commit-env-to-git","content":"Identical pattern to Node: a `.env` file, a `.gitignore` entry for it, and `dotenv` loading it\nat startup. The only thing that changes going forward is *how* you read a value in code —\nNode's `process.env.DATABASE_URL` becomes Python's `os.getenv(\"DATABASE_URL\")`, which you'll\nsee in the very next lesson.","locale":"en"},"645":{"id":"/docs/fastapi/getting-started/project-setup","page_id":"/docs/fastapi/getting-started/project-setup","type":"page","content":"Project Setup","breadcrumbs":["Docs","Backend with FastAPI","Getting Started"],"tags":[],"url":"/docs/fastapi/getting-started/project-setup","locale":"en"},"646":{"id":"/docs/fastapi/getting-started/project-setup-0","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup","content":"Virtual environments, and installing FastAPI's core dependencies","locale":"en"},"647":{"id":"/docs/fastapi/getting-started/project-setup-1","page_id":"/docs/fastapi/getting-started/project-setup","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/project-setup#why-a-virtual-environment","content":"Why a virtual environment?","locale":"en"},"648":{"id":"/docs/fastapi/getting-started/project-setup-2","page_id":"/docs/fastapi/getting-started/project-setup","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/project-setup#creating-the-virtual-environment","content":"Creating the virtual environment","locale":"en"},"649":{"id":"/docs/fastapi/getting-started/project-setup-3","page_id":"/docs/fastapi/getting-started/project-setup","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/project-setup#activating-it","content":"Activating it","locale":"en"},"650":{"id":"/docs/fastapi/getting-started/project-setup-4","page_id":"/docs/fastapi/getting-started/project-setup","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"Installing the core dependencies","locale":"en"},"651":{"id":"/docs/fastapi/getting-started/project-setup-5","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup","content":"Before writing any FastAPI code, you need a properly isolated project. This lesson sets that\nup.","locale":"en"},"652":{"id":"/docs/fastapi/getting-started/project-setup-6","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#why-a-virtual-environment","content":"When you install a Python package, it normally installs **globally** on your machine — not\njust for one project. If Project A needs version 1 of a package and Project B needs version\n2, installing globally means they'd conflict with each other.","locale":"en"},"653":{"id":"/docs/fastapi/getting-started/project-setup-7","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#why-a-virtual-environment","content":"A **virtual environment** fixes this: it's a self-contained folder holding its own copy of\nPython and its own packages, completely separate from your system-wide Python and from every\nother project.","locale":"en"},"654":{"id":"/docs/fastapi/getting-started/project-setup-8","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#why-a-virtual-environment","content":"In Node, you get this isolation for free — every project has its own `node_modules` folder\nautomatically. Python has no equivalent by default, which is exactly why this extra step\nexists: a virtual environment is what makes a Python project behave like a Node project's\n`node_modules`, isolated per project.","locale":"en"},"655":{"id":"/docs/fastapi/getting-started/project-setup-9","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#creating-the-virtual-environment","content":"Inside your project folder, run:","locale":"en"},"656":{"id":"/docs/fastapi/getting-started/project-setup-10","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#creating-the-virtual-environment","content":"This creates a new folder named `venv` containing an isolated Python environment. (The name\n`venv` is just a convention — the command is `venv`, the folder it creates can technically be\nnamed anything, but `venv` is what you'll see almost everywhere.)","locale":"en"},"657":{"id":"/docs/fastapi/getting-started/project-setup-11","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#activating-it","content":"Creating the virtual environment isn't enough — you need to **activate** it in your terminal\nso that `pip` (Python's package installer) and `python` both point at this isolated\nenvironment instead of your system-wide one.","locale":"en"},"658":{"id":"/docs/fastapi/getting-started/project-setup-12","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#activating-it","content":"On Windows:","locale":"en"},"659":{"id":"/docs/fastapi/getting-started/project-setup-13","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#activating-it","content":"On macOS/Linux:","locale":"en"},"660":{"id":"/docs/fastapi/getting-started/project-setup-14","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#activating-it","content":"Once activated, your terminal prompt will show `(venv)` at the start of the line — that's\nyour confirmation that everything you install next goes into this project's isolated\nenvironment, not your entire system.","locale":"en"},"661":{"id":"/docs/fastapi/getting-started/project-setup-15","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#activating-it","content":"You'll need to activate the virtual environment again every time you open a fresh terminal to\nwork on this project.","locale":"en"},"662":{"id":"/docs/fastapi/getting-started/project-setup-16","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"With the virtual environment active, install FastAPI's core toolkit:","locale":"en"},"663":{"id":"/docs/fastapi/getting-started/project-setup-17","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"Here's what each one does:","locale":"en"},"664":{"id":"/docs/fastapi/getting-started/project-setup-18","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"Package","locale":"en"},"665":{"id":"/docs/fastapi/getting-started/project-setup-19","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"Purpose","locale":"en"},"666":{"id":"/docs/fastapi/getting-started/project-setup-20","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"`fastapi`","locale":"en"},"667":{"id":"/docs/fastapi/getting-started/project-setup-21","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"The web framework itself — routing, request handling, validation","locale":"en"},"668":{"id":"/docs/fastapi/getting-started/project-setup-22","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"`uvicorn`","locale":"en"},"669":{"id":"/docs/fastapi/getting-started/project-setup-23","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"The server that actually runs your FastAPI app","locale":"en"},"670":{"id":"/docs/fastapi/getting-started/project-setup-24","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"`sqlalchemy`","locale":"en"},"671":{"id":"/docs/fastapi/getting-started/project-setup-25","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"The ORM you'll use to work with the database","locale":"en"},"672":{"id":"/docs/fastapi/getting-started/project-setup-26","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"`psycopg2-binary`","locale":"en"},"673":{"id":"/docs/fastapi/getting-started/project-setup-27","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"A PostgreSQL driver — lets SQLAlchemy talk to Postgres","locale":"en"},"674":{"id":"/docs/fastapi/getting-started/project-setup-28","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"`python-dotenv`","locale":"en"},"675":{"id":"/docs/fastapi/getting-started/project-setup-29","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"Loads configuration from a `.env` file","locale":"en"},"676":{"id":"/docs/fastapi/getting-started/project-setup-30","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"`mysqlclient`","locale":"en"},"677":{"id":"/docs/fastapi/getting-started/project-setup-31","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"A MySQL driver — lets SQLAlchemy talk to MySQL","locale":"en"},"678":{"id":"/docs/fastapi/getting-started/project-setup-32","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"`pydantic`","locale":"en"},"679":{"id":"/docs/fastapi/getting-started/project-setup-33","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"Validates data and defines the schemas your API accepts and returns","locale":"en"},"680":{"id":"/docs/fastapi/getting-started/project-setup-34","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"`pydantic` is actually installed automatically as part of `fastapi` — you don't strictly need\nto list it yourself. It's included explicitly here because you'll import from it directly and\noften (you already saw why back in \"What is FastAPI?\"), so it's worth having on your radar as\nits own dependency rather than a hidden detail of FastAPI.","locale":"en"},"681":{"id":"/docs/fastapi/getting-started/project-setup-35","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"You'll notice both a PostgreSQL driver **and** a MySQL driver in that list. SQLAlchemy itself\ndoesn't know how to speak to any specific database on its own — it needs a driver matching\nwhichever database you actually connect to. This course's project uses **MySQL**, so\n`mysqlclient` is the one that matters going forward; `psycopg2-binary` is there in case you\never point the same project at Postgres instead.","locale":"en"},"682":{"id":"/docs/fastapi/getting-started/project-setup-36","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"The one worth pausing on is &#x2A;*`uvicorn`**. FastAPI code by itself doesn't run as a server —\nit's just Python code describing routes and logic. `uvicorn` is the actual program that\nstarts a server process, listens for requests, and feeds them into your FastAPI app.","locale":"en"},"683":{"id":"/docs/fastapi/getting-started/project-setup-37","page_id":"/docs/fastapi/getting-started/project-setup","tags":[],"type":"text","url":"/docs/fastapi/getting-started/project-setup#installing-the-core-dependencies","content":"`uvicorn` plays the role that Node.js itself plays for an Express app, or that `nest start`\nhandles for you under the hood — the thing that actually opens a port and starts serving\nrequests. `sqlalchemy` maps to TypeORM/Prisma/Sequelize (an ORM), the database drivers are\nthe same idea as the `pg` or `mysql2` packages those tools need under the hood, and\n`python-dotenv` is the exact same job as Node's `dotenv` package — even the name matches.","locale":"en"},"684":{"id":"/docs/fastapi/getting-started/what-is-fastapi","page_id":"/docs/fastapi/getting-started/what-is-fastapi","type":"page","content":"What is FastAPI?","breadcrumbs":["Docs","Backend with FastAPI","Getting Started"],"tags":[],"url":"/docs/fastapi/getting-started/what-is-fastapi","locale":"en"},"685":{"id":"/docs/fastapi/getting-started/what-is-fastapi-0","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi","content":"A modern Python framework built for writing APIs fast, with less code","locale":"en"},"686":{"id":"/docs/fastapi/getting-started/what-is-fastapi-1","page_id":"/docs/fastapi/getting-started/what-is-fastapi","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/what-is-fastapi#a-micro-framework","content":"A micro framework","locale":"en"},"687":{"id":"/docs/fastapi/getting-started/what-is-fastapi-2","page_id":"/docs/fastapi/getting-started/what-is-fastapi","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/what-is-fastapi#validation-and-docs-built-in","content":"Validation and docs, built in","locale":"en"},"688":{"id":"/docs/fastapi/getting-started/what-is-fastapi-3","page_id":"/docs/fastapi/getting-started/what-is-fastapi","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/what-is-fastapi#fast--genuinely-fast","content":"Fast — genuinely fast","locale":"en"},"689":{"id":"/docs/fastapi/getting-started/what-is-fastapi-4","page_id":"/docs/fastapi/getting-started/what-is-fastapi","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/what-is-fastapi#less-code-more-power","content":"Less code, more power","locale":"en"},"690":{"id":"/docs/fastapi/getting-started/what-is-fastapi-5","page_id":"/docs/fastapi/getting-started/what-is-fastapi","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/what-is-fastapi#great-for-ml-and-data-apps","content":"Great for ML and data apps","locale":"en"},"691":{"id":"/docs/fastapi/getting-started/what-is-fastapi-6","page_id":"/docs/fastapi/getting-started/what-is-fastapi","type":"heading","tags":[],"url":"/docs/fastapi/getting-started/what-is-fastapi#built-on-the-openapi-standard","content":"Built on the OpenAPI standard","locale":"en"},"692":{"id":"/docs/fastapi/getting-started/what-is-fastapi-7","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi","content":"You now understand *why* a backend exists. From here on, you'll learn to build one — using\n**FastAPI**, a Python framework built specifically for writing APIs.","locale":"en"},"693":{"id":"/docs/fastapi/getting-started/what-is-fastapi-8","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi#a-micro-framework","content":"FastAPI is a **micro framework** — it gives you a small, focused core (routing, request\nhandling) rather than a huge all-in-one system with a rigid structure. You choose your own\nproject layout and add only the pieces you actually need. This also makes it **flexible**:\nthere's no single \"correct\" way FastAPI forces your code into.","locale":"en"},"694":{"id":"/docs/fastapi/getting-started/what-is-fastapi-9","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi#validation-and-docs-built-in","content":"FastAPI is built on top of two other libraries, and it's worth knowing their names because\nyou'll see them constantly:","locale":"en"},"695":{"id":"/docs/fastapi/getting-started/what-is-fastapi-10","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi#validation-and-docs-built-in","content":"**Starlette** — handles the actual web layer underneath FastAPI: receiving requests,\nrouting them to the right function, sending responses","locale":"en"},"696":{"id":"/docs/fastapi/getting-started/what-is-fastapi-11","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi#validation-and-docs-built-in","content":"**Pydantic** — handles data validation, using the type hints you learned in Phase 7 of\nPython Notes","locale":"en"},"697":{"id":"/docs/fastapi/getting-started/what-is-fastapi-12","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi#validation-and-docs-built-in","content":"That second point is the big one. Write a type hint on your endpoint's data, like `age: int`,\nand FastAPI automatically:","locale":"en"},"698":{"id":"/docs/fastapi/getting-started/what-is-fastapi-13","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi#validation-and-docs-built-in","content":"**Validates** incoming data against it — a request sending `age: \"abc\"` gets rejected\nautomatically, before your code even runs","locale":"en"},"699":{"id":"/docs/fastapi/getting-started/what-is-fastapi-14","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi#validation-and-docs-built-in","content":"**Generates interactive documentation** for it — a page where anyone can see every\nendpoint, what data it expects, and try it out live, with zero extra code from you","locale":"en"},"700":{"id":"/docs/fastapi/getting-started/what-is-fastapi-15","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi#validation-and-docs-built-in","content":"That second point is genuinely one of FastAPI's best features: the moment you define an\nendpoint with type hints, you get a working documentation page for free.","locale":"en"},"701":{"id":"/docs/fastapi/getting-started/what-is-fastapi-16","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi#fast--genuinely-fast","content":"\"FastAPI\" isn't just a name. Because it's built on **Starlette**, which supports Python's\n`async`/`await` (Phase 8 of Python Notes), FastAPI can handle a very high volume of requests\nefficiently. In real benchmarks, it performs competitively with — and sometimes faster than —\nNode.js and Go, which is unusual for a Python framework.","locale":"en"},"702":{"id":"/docs/fastapi/getting-started/what-is-fastapi-17","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi#less-code-more-power","content":"Because type hints drive both validation and documentation automatically, you end up writing\nfar less repetitive code than frameworks that require separate, hand-written validation\nschemas. The type hints you'd write anyway, just to describe your data, *are* the validation\nrules.","locale":"en"},"703":{"id":"/docs/fastapi/getting-started/what-is-fastapi-18","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi#great-for-ml-and-data-apps","content":"Python is the dominant language for machine learning and data science (NumPy, Pandas,\nPyTorch, and so on). Because FastAPI is Python, it's a natural way to take a trained ML model\nor a data pipeline and expose it as an API — no cross-language bridge required.","locale":"en"},"704":{"id":"/docs/fastapi/getting-started/what-is-fastapi-19","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi#built-on-the-openapi-standard","content":"FastAPI automatically generates an **OpenAPI** specification for your entire API — an\nindustry-standard, machine-readable description of every endpoint. This is what powers the\ninteractive **Swagger UI** docs mentioned above, available out of the box at `/docs` on any\nFastAPI app you build, with no setup.","locale":"en"},"705":{"id":"/docs/fastapi/getting-started/what-is-fastapi-20","page_id":"/docs/fastapi/getting-started/what-is-fastapi","tags":[],"type":"text","url":"/docs/fastapi/getting-started/what-is-fastapi#built-on-the-openapi-standard","content":"Think of Starlette as FastAPI's equivalent of the HTTP layer Express itself provides, and\nPydantic as replacing manual validation (`express-validator`, Zod) or Nest's DTOs +\n`class-validator` — except it's automatic from your type hints, not extra decorators or\nschemas you write by hand. And the auto-generated Swagger docs replace what you'd normally\nset up yourself with `swagger-jsdoc`/`swagger-ui-express` in Express, or `@nestjs/swagger` in\nNest — in FastAPI, it's there from the first endpoint you write, automatically.","locale":"en"},"706":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","type":"page","content":"Putting It Together — How Does YouTube Work?","breadcrumbs":["Docs","Backend with FastAPI","Web Fundamentals"],"tags":[],"url":"/docs/fastapi/web-fundamentals/how-youtube-works","locale":"en"},"707":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-0","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works","content":"A real-world walkthrough that ties client, backend, database, and file storage together","locale":"en"},"708":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-1","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/how-youtube-works#two-very-different-kinds-of-data","content":"Two very different kinds of data","locale":"en"},"709":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-2","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/how-youtube-works#why-databases-arent-built-for-this","content":"Why databases aren't built for this","locale":"en"},"710":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-3","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/how-youtube-works#meet-the-storage-server","content":"Meet the storage server","locale":"en"},"711":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-4","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/how-youtube-works#the-full-picture","content":"The full picture","locale":"en"},"712":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-5","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/how-youtube-works#walking-through-uploading-a-video","content":"Walking through: uploading a video","locale":"en"},"713":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-6","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/how-youtube-works#walking-through-watching-a-video","content":"Walking through: watching a video","locale":"en"},"714":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-7","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/how-youtube-works#why-this-matters-going-forward","content":"Why this matters going forward","locale":"en"},"715":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-8","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works","content":"You now know the pieces: client, backend, database. This lesson puts them together through a\nreal example everyone already understands — **YouTube** — and along the way, uncovers one\nmore piece you haven't met yet.","locale":"en"},"716":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-9","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#two-very-different-kinds-of-data","content":"Think about everything YouTube needs to keep track of for a single video:","locale":"en"},"717":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-10","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#two-very-different-kinds-of-data","content":"Its **title**, **description**, **upload date**, **view count**, **like count**","locale":"en"},"718":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-11","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#two-very-different-kinds-of-data","content":"Its **comments**, and who posted each one","locale":"en"},"719":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-12","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#two-very-different-kinds-of-data","content":"The **actual video file** itself — and its thumbnail image","locale":"en"},"720":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-13","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#two-very-different-kinds-of-data","content":"The first two are exactly what you just learned: rows in database tables. A `videos` table\nwith a `title` column and a `view_count` column fits perfectly.","locale":"en"},"721":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-14","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#two-very-different-kinds-of-data","content":"But that video file? A single video can be hundreds of megabytes, even gigabytes. That raises\na real question:","locale":"en"},"722":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-15","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#two-very-different-kinds-of-data","content":"**Can't we just save the video file in the database too, in some column?**","locale":"en"},"723":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-16","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#why-databases-arent-built-for-this","content":"Technically, some databases can store large binary blobs — but doing this at YouTube's scale\nwould be a bad idea:","locale":"en"},"724":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-17","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#why-databases-arent-built-for-this","content":"Databases are built to be searched, filtered, and sorted quickly across *many small rows* —\nnot to hold enormous files that nobody \"searches\" the *contents* of","locale":"en"},"725":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-18","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#why-databases-arent-built-for-this","content":"A database that also held every raw video file would become massive, making backups,\nreplication, and queries all dramatically slower","locale":"en"},"726":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-19","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#why-databases-arent-built-for-this","content":"Databases aren't designed to **stream** a large file out to millions of viewers at once —\nthat's a completely different kind of workload","locale":"en"},"727":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-20","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#why-databases-arent-built-for-this","content":"So real applications split the two apart:","locale":"en"},"728":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-21","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#meet-the-storage-server","content":"A **storage server** (often called *object storage* — think AWS S3 or Google Cloud Storage)\nis a service whose only job is storing and serving large files efficiently. The database\nnever holds the video itself — it only holds a **reference** to where that file lives on the\nstorage server (a URL or file path).","locale":"en"},"729":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-22","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#meet-the-storage-server","content":"Large platforms also place a **CDN** (Content Delivery Network) in front of their storage —\ncopies of popular videos get cached on servers physically close to viewers all over the\nworld, so someone in India isn't fetching every byte from a server on the other side of the\nplanet. You don't need to build one of these yourself; it's a service you connect to, the\nsame way you'd connect to a database.","locale":"en"},"730":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-23","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#walking-through-uploading-a-video","content":"You select a video file and hit upload in the client.","locale":"en"},"731":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-24","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#walking-through-uploading-a-video","content":"The client sends the file to the **backend**.","locale":"en"},"732":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-25","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#walking-through-uploading-a-video","content":"The backend sends the actual video file to the **storage server** to be saved.","locale":"en"},"733":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-26","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#walking-through-uploading-a-video","content":"The storage server gives back a reference — where that file now lives.","locale":"en"},"734":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-27","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#walking-through-uploading-a-video","content":"The backend saves the **metadata** (title, description, your user id, and that file\nreference) as a new row in the **database**.","locale":"en"},"735":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-28","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#walking-through-watching-a-video","content":"You open a video page in the client.","locale":"en"},"736":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-29","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#walking-through-watching-a-video","content":"The client asks the **backend** for that video's info.","locale":"en"},"737":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-30","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#walking-through-watching-a-video","content":"The backend reads the row from the **database** — title, description, view count, and the\nstored file reference.","locale":"en"},"738":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-31","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#walking-through-watching-a-video","content":"The backend sends that data back to the client, including where the actual video file\nlives.","locale":"en"},"739":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-32","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#walking-through-watching-a-video","content":"The client's video player fetches the video bytes **directly from the storage server /\nCDN** — not routed back through the backend — so playback is fast and doesn't load down\nyour API server.","locale":"en"},"740":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-33","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#why-this-matters-going-forward","content":"This same split shows up in almost every real app you'll build: a database for structured,\nsearchable data, and a storage service for the files themselves (profile pictures, PDFs,\naudio, video). In this course, you'll build the backend and database side yourself with\nFastAPI; storage servers and CDNs are usually a cloud service you connect to, not something\nyou build from scratch.","locale":"en"},"741":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-34","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#why-this-matters-going-forward","content":"With client, backend, database, and storage all in place, you now have the complete mental\nmap of how a real application is built — everything from here on is about learning the tools\nto build the backend piece of it, properly.","locale":"en"},"742":{"id":"/docs/fastapi/web-fundamentals/how-youtube-works-35","page_id":"/docs/fastapi/web-fundamentals/how-youtube-works","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/how-youtube-works#why-this-matters-going-forward","content":"Same architecture you already know — an Express/Nest API talking to Postgres/MongoDB for\nstructured data, and to S3 (or similar) for files, usually via a pre-signed upload URL or a\nmultipart upload endpoint. FastAPI will follow the identical pattern; you're not learning a\nnew architecture here, just new syntax for a shape you've already built before.","locale":"en"},"743":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","type":"page","content":"Web 1.0, Web 2.0 & Why React","breadcrumbs":["Docs","Backend with FastAPI","Web Fundamentals"],"tags":[],"url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","locale":"en"},"744":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-0","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","content":"The full page reload problem — and why modern apps stopped doing it","locale":"en"},"745":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-1","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#web-10--read-only-pages","content":"Web 1.0 — read-only pages","locale":"en"},"746":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-2","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#web-20--the-interactive-web","content":"Web 2.0 — the interactive web","locale":"en"},"747":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-3","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#the-full-page-reload-problem","content":"The full page reload problem","locale":"en"},"748":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-4","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-react","content":"Why React","locale":"en"},"749":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-5","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"Why this matters for a backend developer","locale":"en"},"750":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-6","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","content":"Websites haven't always worked the way they do today. To understand why tools like React\nexist, you need to see the problem they were built to solve.","locale":"en"},"751":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-7","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#web-10--read-only-pages","content":"The earliest websites (roughly the 1990s) were **static and read-only** — closer to a digital\nbrochure than an app. A server had a folder of pre-written HTML files, and every visitor got\nexactly the same page. There was no login, no comments, no personalization. You looked, you\ndidn't interact.","locale":"en"},"752":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-8","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#web-20--the-interactive-web","content":"Starting in the 2000s, the web became **interactive and user-driven**: logins, comments,\nlikes, posting your own content — think early Facebook, YouTube, blogs with comment sections.\nThe server now generated a *different* page for every user, built from data stored in a\ndatabase.","locale":"en"},"753":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-9","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#web-20--the-interactive-web","content":"This is a huge leap forward — but under the hood, most Web 2.0 sites still worked the exact\nsame way as Web 1.0 for one crucial thing: &#x2A;*every click reloaded the entire page.**","locale":"en"},"754":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-10","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#the-full-page-reload-problem","content":"Click a link on a traditional website (even a modern-looking one built with plain\nHTML/CSS/JS), and this happens:","locale":"en"},"755":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-11","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#the-full-page-reload-problem","content":"Every single action — clicking a link, submitting a form, even liking a post — could mean\nthrowing away the whole page and rebuilding it from nothing. That means:","locale":"en"},"756":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-12","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#the-full-page-reload-problem","content":"A visible **white flash** while the old page disappears and the new one loads","locale":"en"},"757":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-13","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#the-full-page-reload-problem","content":"**Everything resets** — scroll position, an open dropdown, a half-filled form, a playing\nvideo — all gone, because the browser is starting over completely","locale":"en"},"758":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-14","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#the-full-page-reload-problem","content":"Re-downloading and re-running the *same* CSS and JS files you already had, every time","locale":"en"},"759":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-15","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#the-full-page-reload-problem","content":"Imagine a chat app where sending one message reloaded the entire page, wiped your scroll\nposition, and re-downloaded the whole app — just to show one new message. That's not\nacceptable for the kind of apps people expect today.","locale":"en"},"760":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-16","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-react","content":"React (and similar tools) exist to fix exactly this. The core idea: **load the page once,\nthen only update the small part that actually changed** — never throw away and rebuild the\nwhole thing again.","locale":"en"},"761":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-17","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-react","content":"Notice the key difference from the diagram above: the server isn't sending a full HTML page\nanymore — it's sending back **just the data**. That's the piece that matters most for this\ncourse.","locale":"en"},"762":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-18","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"This shift changes what a backend server's job even is:","locale":"en"},"763":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-19","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"Web 1.0 / 2.0 style","locale":"en"},"764":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-20","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"Modern React-style","locale":"en"},"765":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-21","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"Server sends back","locale":"en"},"766":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-22","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"A complete HTML page","locale":"en"},"767":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-23","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"Just data (usually JSON)","locale":"en"},"768":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-24","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"Who builds the page","locale":"en"},"769":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-25","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"The server","locale":"en"},"770":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-26","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"The browser (React), once","locale":"en"},"771":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-27","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"What happens on each action","locale":"en"},"772":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-28","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"Full page reload","locale":"en"},"773":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-29","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"Only the changed part updates","locale":"en"},"774":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-30","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"**This is exactly why we're learning FastAPI**: FastAPI's job in this stack isn't to generate\nHTML pages — it's to answer requests with data. A separate React app (running in the\nbrowser) is responsible for turning that data into an actual page, and updating it without\never reloading. Backend and frontend become two separate programs that talk to each other\npurely through requests and responses of data.","locale":"en"},"775":{"id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react-31","page_id":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/web-evolution-and-why-react#why-this-matters-for-a-backend-developer","content":"You've almost certainly already done this: an Express route that calls `res.json({ ... })`\ninstead of rendering a template with something like EJS or Pug is *already* the \"modern\"\napproach — server as a pure data API, frontend as a separate React app. FastAPI works on that\nexact same principle, so this mental model isn't new to you at all — only the Python syntax\naround it will be.","locale":"en"},"776":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","type":"page","content":"What is a Database?","breadcrumbs":["Docs","Backend with FastAPI","Web Fundamentals"],"tags":[],"url":"/docs/fastapi/web-fundamentals/what-is-a-database","locale":"en"},"777":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-0","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database","content":"Where the backend keeps data that has to survive and stay organized","locale":"en"},"778":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-1","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/what-is-a-database#why-not-just-store-data-in-a-variable","content":"Why not just store data in a variable?","locale":"en"},"779":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-2","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/what-is-a-database#what-a-database-actually-is","content":"What a database actually is","locale":"en"},"780":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-3","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/what-is-a-database#only-the-backend-talks-to-the-database","content":"Only the backend talks to the database","locale":"en"},"781":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-4","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/what-is-a-database#the-kind-of-database-youll-use-in-this-course","content":"The kind of database you'll use in this course","locale":"en"},"782":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-5","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database","content":"The last lesson established that the backend is a trusted boundary — the client never\ntouches secrets, source code, or raw data directly. But the backend needs somewhere to\nactually **keep** that data. That's what a database is for.","locale":"en"},"783":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-6","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database#why-not-just-store-data-in-a-variable","content":"You could imagine a backend that keeps everything in a plain Python list, like the `users`\nlist from your Final Practice exercise back in the Python Notes. That works while the program\nis running — but it has a fatal flaw: &#x2A;*the moment the server restarts, everything is gone.**\nA crash, a deploy, a simple reboot — all of it wipes the list clean.","locale":"en"},"784":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-7","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database#why-not-just-store-data-in-a-variable","content":"A real application needs data to:","locale":"en"},"785":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-8","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database#why-not-just-store-data-in-a-variable","content":"**Survive** restarts and crashes","locale":"en"},"786":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-9","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database#why-not-just-store-data-in-a-variable","content":"Be **searched and filtered** quickly, even with millions of records","locale":"en"},"787":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-10","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database#why-not-just-store-data-in-a-variable","content":"Be **shared safely** across many requests happening at the same time","locale":"en"},"788":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-11","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database#why-not-just-store-data-in-a-variable","content":"That's a job for a dedicated piece of software — a **database**.","locale":"en"},"789":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-12","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database#what-a-database-actually-is","content":"A database is a separate program (often running as its own server) whose entire purpose is\nstoring data reliably and retrieving it fast. Think of it as a very well-organized set of\nspreadsheets:","locale":"en"},"790":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-13","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database#what-a-database-actually-is","content":"A **table** is one spreadsheet — for example, a `users` table, or a `videos` table","locale":"en"},"791":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-14","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database#what-a-database-actually-is","content":"A **row** is one record in that spreadsheet — one specific user, one specific video","locale":"en"},"792":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-15","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database#what-a-database-actually-is","content":"A **column** defines one piece of information every row has — `id`, `name`, `email`","locale":"en"},"793":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-16","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database#what-a-database-actually-is","content":"This should look familiar — it's the same shape as the list-of-dicts you already worked with\nin Python Notes' Phase 2 and Final Practice. A database table is essentially that same idea,\nmade permanent and searchable at scale.","locale":"en"},"794":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-17","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database#only-the-backend-talks-to-the-database","content":"The client never connects to the database directly — it never even knows the database\nexists. It only ever talks to the backend, and the backend decides what to read, what to\nwrite, and what to send back. This is the same trusted-boundary idea from the last lesson,\njust with a concrete example of what's actually being hidden.","locale":"en"},"795":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-18","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database#the-kind-of-database-youll-use-in-this-course","content":"There are different families of databases, but the most common kind — and the one this course\nuses with FastAPI — is a **relational database** (like PostgreSQL or MySQL): data organized\ninto clearly defined tables with columns, similar to the `users` table above. You'll get\nhands-on with this properly in a later lesson — for now, just hold onto the mental picture:\n&#x2A;*tables, rows, and columns, living inside a server only the backend can reach.**","locale":"en"},"796":{"id":"/docs/fastapi/web-fundamentals/what-is-a-database-19","page_id":"/docs/fastapi/web-fundamentals/what-is-a-database","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-database#the-kind-of-database-youll-use-in-this-course","content":"Exactly the same relationship as `pg`, Prisma, or TypeORM talking to a Postgres/MySQL\ndatabase from an Express/Nest server — the client still only ever calls your API, never the\ndatabase itself. FastAPI will use its own tools for this (you'll meet them soon), but the\narchitecture is identical to what you already do.","locale":"en"},"797":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","type":"page","content":"What is a Website?","breadcrumbs":["Docs","Backend with FastAPI","Web Fundamentals"],"tags":[],"url":"/docs/fastapi/web-fundamentals/what-is-a-website","locale":"en"},"798":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-0","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-website","content":"HTML, CSS, and JS — and what actually happens when a page loads","locale":"en"},"799":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-1","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/what-is-a-website#the-three-building-blocks","content":"The three building blocks","locale":"en"},"800":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-2","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/what-is-a-website#what-happens-when-you-visit-a-page","content":"What happens when you visit a page","locale":"en"},"801":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-3","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-website","content":"In the last lesson you saw that a **server** answers requests from a **client**. A website is\nsimply what most servers send back as their answer.","locale":"en"},"802":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-4","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-website#the-three-building-blocks","content":"Every website, no matter how complex it looks, is built from three things:","locale":"en"},"803":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-5","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-website#the-three-building-blocks","content":"**HTML** — the structure and content (the text, images, buttons — what's on the page)","locale":"en"},"804":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-6","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-website#the-three-building-blocks","content":"**CSS** — the styling (colors, spacing, fonts — how it looks)","locale":"en"},"805":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-7","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-website#the-three-building-blocks","content":"**JavaScript** — the behavior (what happens when you click, type, or scroll)","locale":"en"},"806":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-8","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-website#the-three-building-blocks","content":"The server's job is to send these files to whichever browser asks for them. The browser's job\nis to read them and turn them into the page you actually see.","locale":"en"},"807":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-9","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-website#what-happens-when-you-visit-a-page","content":"Opening a single webpage is rarely just *one* request — it's usually several, one after\nanother:","locale":"en"},"808":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-10","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-website#what-happens-when-you-visit-a-page","content":"The browser asks for the page itself (`index.html`).","locale":"en"},"809":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-11","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-website#what-happens-when-you-visit-a-page","content":"While reading that HTML, the browser notices it references a stylesheet and a script file.","locale":"en"},"810":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-12","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-website#what-happens-when-you-visit-a-page","content":"It sends **separate requests** for those too.","locale":"en"},"811":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-13","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-website#what-happens-when-you-visit-a-page","content":"Once everything has arrived, the browser combines them into the page you see on screen.","locale":"en"},"812":{"id":"/docs/fastapi/web-fundamentals/what-is-a-website-14","page_id":"/docs/fastapi/web-fundamentals/what-is-a-website","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-a-website#what-happens-when-you-visit-a-page","content":"This matters later: every one of those arrows in the diagram is a full round trip across the\ninternet — a request, then a response. Keeping that number small (and not repeating it\nunnecessarily) is a big part of why the web has evolved the way it has, which is exactly\nwhat the next lesson is about.","locale":"en"},"813":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","type":"page","content":"What is the Internet?","breadcrumbs":["Docs","Backend with FastAPI","Web Fundamentals"],"tags":[],"url":"/docs/fastapi/web-fundamentals/what-is-the-internet","locale":"en"},"814":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-0","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet","content":"The network that makes backend development possible","locale":"en"},"815":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-1","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/what-is-the-internet#a-simple-definition","content":"A simple definition","locale":"en"},"816":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-2","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/what-is-the-internet#every-computer-has-an-address","content":"Every computer has an address","locale":"en"},"817":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-3","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/what-is-the-internet#two-roles-asking-and-answering","content":"Two roles: asking and answering","locale":"en"},"818":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-4","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/what-is-the-internet#why-this-matters-for-you","content":"Why this matters for you","locale":"en"},"819":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-5","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet","content":"Before writing a single line of backend code, you need a clear picture of what you're\nactually building on top of. So let's start at the very bottom: &#x2A;*what is the internet?**","locale":"en"},"820":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-6","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#a-simple-definition","content":"The internet is a huge network of computers all over the world, connected together so they\ncan send information to each other.","locale":"en"},"821":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-7","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#a-simple-definition","content":"That's really it. Your phone, your laptop, and the servers that run apps like Instagram or\nNetflix are all just computers on this same giant network — some asking for information,\nothers answering.","locale":"en"},"822":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-8","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#every-computer-has-an-address","content":"For one computer to send data to another, it needs to know where to send it. Every device on\nthe internet has an **IP address** — a unique set of numbers that identifies it, the same way\na house needs a postal address before anyone can deliver mail to it.","locale":"en"},"823":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-9","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#every-computer-has-an-address","content":"You'll rarely type an IP address yourself — that's what domain names like `google.com` are\nfor, they're just a human-friendly label that gets translated into an IP address behind the\nscenes. But the underlying idea is the same: &#x2A;*every computer on the internet can be found at\nan address.**","locale":"en"},"824":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-10","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#two-roles-asking-and-answering","content":"Almost everything that happens on the internet comes down to two roles:","locale":"en"},"825":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-11","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#two-roles-asking-and-answering","content":"**Client** — the one asking for something (a browser, a mobile app)","locale":"en"},"826":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-12","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#two-roles-asking-and-answering","content":"**Server** — the one answering (a computer that's always on, waiting for questions)","locale":"en"},"827":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-13","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#two-roles-asking-and-answering","content":"For example, when you open a browser and go to a website:","locale":"en"},"828":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-14","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#two-roles-asking-and-answering","content":"Your browser (**client**) sends a **request** out onto the internet: \"Please give me this\nwebpage.\"","locale":"en"},"829":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-15","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#two-roles-asking-and-answering","content":"The request travels across the network to the right computer, based on its address.","locale":"en"},"830":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-16","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#two-roles-asking-and-answering","content":"That computer (**server**) sends a **response** back: the actual webpage content.","locale":"en"},"831":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-17","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#two-roles-asking-and-answering","content":"Your browser receives it and displays it on your screen.","locale":"en"},"832":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-18","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#two-roles-asking-and-answering","content":"This request → response pattern is the single most important idea in this entire course.\nEverything you'll build runs on top of it.","locale":"en"},"833":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-19","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#why-this-matters-for-you","content":"**Backend development means building the \"server\" side of this picture** — the program that\nsits there, always on, waiting for requests, and deciding what to send back.","locale":"en"},"834":{"id":"/docs/fastapi/web-fundamentals/what-is-the-internet-20","page_id":"/docs/fastapi/web-fundamentals/what-is-the-internet","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/what-is-the-internet#why-this-matters-for-you","content":"Everything you've learned in Python so far — functions, dictionaries, classes — is about to\nbecome the logic that runs *inside* that server, answering the requests your users' browsers\nand apps send in.","locale":"en"},"835":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","type":"page","content":"What is the Backend, and Why Do We Need One?","breadcrumbs":["Docs","Backend with FastAPI","Web Fundamentals"],"tags":[],"url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","locale":"en"},"836":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-0","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","content":"Why business logic can't just live in the browser","locale":"en"},"837":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-1","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#the-one-rule-that-explains-everything","content":"The one rule that explains everything","locale":"en"},"838":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-2","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#what-the-client-is-allowed-to-see","content":"What the client is allowed to see","locale":"en"},"839":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-3","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#what-if-there-were-no-backend-at-all","content":"What if there were no backend at all?","locale":"en"},"840":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-4","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","type":"heading","tags":[],"url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#the-takeaway","content":"The takeaway","locale":"en"},"841":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-5","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","content":"You already know the backend is the \"server\" side of the client/server picture. This lesson\nis about *why* it needs to exist at all — why can't a website just be HTML, CSS, and\nJavaScript, with everything happening in the browser?","locale":"en"},"842":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-6","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#the-one-rule-that-explains-everything","content":"**Anything you send to the browser, the user can see and change.**","locale":"en"},"843":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-7","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#the-one-rule-that-explains-everything","content":"Open any website, right-click, \"View Source\" or open DevTools — every line of HTML, CSS, and\nJavaScript is right there, fully readable. Nothing that reaches the browser stays private.\nNot \"hard to find\" — genuinely, completely visible, and editable, by anyone who opens it.","locale":"en"},"844":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-8","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#the-one-rule-that-explains-everything","content":"The backend exists because some things must **never** be visible or editable by the user:","locale":"en"},"845":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-9","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#the-one-rule-that-explains-everything","content":"The actual logic that decides prices, discounts, permissions, or scores","locale":"en"},"846":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-10","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#the-one-rule-that-explains-everything","content":"Passwords, and how they're checked","locale":"en"},"847":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-11","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#the-one-rule-that-explains-everything","content":"Secret keys for payment providers, email services, or other paid APIs","locale":"en"},"848":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-12","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#the-one-rule-that-explains-everything","content":"The database itself — where everyone's data actually lives","locale":"en"},"849":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-13","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#what-the-client-is-allowed-to-see","content":"A user only ever sees two things:","locale":"en"},"850":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-14","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#what-the-client-is-allowed-to-see","content":"The **URL** they called (e.g. `POST /orders`)","locale":"en"},"851":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-15","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#what-the-client-is-allowed-to-see","content":"Whatever **data** came back in the response","locale":"en"},"852":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-16","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#what-the-client-is-allowed-to-see","content":"They never see the code that ran to produce that response. The backend's internal logic —\nhow it validated the request, which database it checked, what business rules it applied — is\ncompletely invisible on the other side of that URL.","locale":"en"},"853":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-17","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#what-the-client-is-allowed-to-see","content":"This is the whole point of a backend: it's a boundary. Requests go in, responses come out,\nand everything that happens in between is the developer's business, not the user's.","locale":"en"},"854":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-18","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#what-if-there-were-no-backend-at-all","content":"Imagine trying to build an online store with *only* HTML, CSS, and JavaScript running in the\nbrowser — no server, no database, nothing hidden.","locale":"en"},"855":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-19","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#what-if-there-were-no-backend-at-all","content":"**Prices and discounts couldn't be trusted.** If the \"final price\" is calculated by\nJavaScript running in the user's own browser, the user can open DevTools and change it before\ncheckout. There's no second, trusted opinion checking the real price — the browser *is* the\nonly opinion, and the user fully controls it.","locale":"en"},"856":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-20","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#what-if-there-were-no-backend-at-all","content":"**Logins couldn't be secure.** If checking a password is a line of JavaScript like\n`if (password === \"admin123\")`, that string is sitting right there in the page's source code\nfor anyone to read. Worse, a user could just skip the check entirely by editing the code\nrunning in their own browser.","locale":"en"},"857":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-21","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#what-if-there-were-no-backend-at-all","content":"**Data couldn't be shared or kept safe.** Without a database, data can only live in the\nbrowser itself (e.g. `localStorage`) — meaning it exists on *that one device, in that one\nbrowser*, invisible to everyone else. Two users could never see each other's posts. You\ncouldn't check your own account from your phone. Clear your browser data, and everything is\ngone forever.","locale":"en"},"858":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-22","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#what-if-there-were-no-backend-at-all","content":"**Secrets couldn't stay secret.** Calling a paid third-party service (email, SMS, payments)\nrequires a secret API key. If that key lives in browser JavaScript, it ships to every visitor\n— anyone can extract it from the page and use it as their own, at your expense.","locale":"en"},"859":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-23","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#what-if-there-were-no-backend-at-all","content":"None of this is a small inconvenience — it means **nothing on the site could actually be\ntrusted**. A backend is what turns \"a page that runs some code\" into \"a system whose rules\nactually hold.\"","locale":"en"},"860":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-24","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#the-takeaway","content":"The backend is the one place in your entire application that only *you*, the developer,\ncontrol. The user can call its URLs and see its responses — but never its code, its\ndatabase, or its secrets. Everything you'll build with FastAPI from here on lives inside that\ntrusted boundary.","locale":"en"},"861":{"id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend-25","page_id":"/docs/fastapi/web-fundamentals/why-we-need-a-backend","tags":[],"type":"text","url":"/docs/fastapi/web-fundamentals/why-we-need-a-backend#the-takeaway","content":"This is precisely why an Express/Nest server exists in your past projects too — it's the same\n\"trusted boundary\" idea, whether the request handler is written in a Express route, a Nest\ncontroller method, or — starting now — a FastAPI path operation function. The concept doesn't\nchange; only the syntax will.","locale":"en"},"862":{"id":"/docs/fastapi/todo-api/create-todo-endpoint","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","type":"page","content":"Create Todo — Your First Endpoint","breadcrumbs":["Docs","Backend with FastAPI","Building the Todo API"],"tags":[],"url":"/docs/fastapi/todo-api/create-todo-endpoint","locale":"en"},"863":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-0","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint","content":"The FastAPI app, the database session dependency, and your first route","locale":"en"},"864":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-1","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/create-todo-endpoint#the-app","content":"The app","locale":"en"},"865":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-2","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/create-todo-endpoint#creating-the-table-for-real","content":"Creating the table for real","locale":"en"},"866":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-3","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/create-todo-endpoint#the-database-session-dependency","content":"The database session dependency","locale":"en"},"867":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-4","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/create-todo-endpoint#depends--wiring-the-dependency-into-a-route","content":"Depends — wiring the dependency into a route","locale":"en"},"868":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-5","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/create-todo-endpoint#the-route","content":"The route","locale":"en"},"869":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-6","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/create-todo-endpoint#mainpy-so-far","content":"`main.py` so far","locale":"en"},"870":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-7","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint","content":"You have a model and a schema. Now it's time to actually serve requests: `main.py` is where\nyour FastAPI app comes together, and where you'll write your first real endpoint.","locale":"en"},"871":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-8","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint#the-app","content":"`app = FastAPI()` creates the actual application object. Every route you write attaches to\nthis `app`, and it's this object that `uvicorn` (installed back in Project Setup) actually\nruns as a server.","locale":"en"},"872":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-9","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint#creating-the-table-for-real","content":"`models.py` only ever *described* the `todo` table — nothing had told the database to\nactually create it, until now:","locale":"en"},"873":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-10","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint#creating-the-table-for-real","content":"`Base.metadata` knows about every model that inherits from `Base` — `Todo`, in this case,\nregistered simply because `main.py` imports it above. `create_all(bind=engine)` checks the\ndatabase behind that `engine` and creates any of those tables that don't already exist yet.\nIt's safe to leave running every time the app starts: existing tables are left alone, and\nonly what's missing gets created.","locale":"en"},"874":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-11","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint#creating-the-table-for-real","content":"If a model's `String` columns don't specify a length, this exact line is where you'd find out\n— MySQL requires an explicit length on every `VARCHAR` column, so `create_all` fails with\n`VARCHAR requires a length on dialect mysql` until every `String` in `models.py` is given one\n(`String(200)`, for example).","locale":"en"},"875":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-12","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint#the-database-session-dependency","content":"This is the function the Database Connection lesson promised was coming. It's a **FastAPI\ndependency** — a function a route can ask for something from, without worrying about how\nthat something is created or cleaned up.","locale":"en"},"876":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-13","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint#the-database-session-dependency","content":"Notice it uses `yield` instead of `return` (Phase 5 and 8 of Python Notes covered generators\nand `async`/`await` — this is a related idea): calling `SessionLocal()` creates a new\nsession, `yield db` hands that session to whichever route asked for it, and once that route\nfinishes — successfully *or* with an error — execution resumes right after the `yield`, and\n`finally: db.close()` guarantees the session gets closed either way.","locale":"en"},"877":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-14","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint#depends--wiring-the-dependency-into-a-route","content":"`db: Session = Depends(get_db)` tells FastAPI: &#x2A;before running this route, call `get_db()`,\nwait for its `yield`, and pass whatever it yields in as `db`.* You never call `get_db()`\nyourself — FastAPI calls it for you, for every request that needs a database session.","locale":"en"},"878":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-15","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint#the-route","content":"**`@app.post(\"/todos\", response_model=TodoSchema)`** — a decorator that registers this\nfunction to handle `POST` requests to `/todos`. `response_model=TodoSchema` tells FastAPI\nwhat shape the returned data should be validated and serialized into before it's sent back —\nand it's also what shows up in your auto-generated docs for this endpoint.","locale":"en"},"879":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-16","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint#the-route","content":"**`todo: TodoCreate`** — the request body. FastAPI reads the incoming JSON and validates it\nagainst `TodoCreate` automatically — the same automatic validation from the very first\nFastAPI lesson, now applied to a real request. This is the payoff from the Creating the Todo\nSchema lesson: the **input** type (`TodoCreate`) has no `id`, so a client can't send one —\nwhile the **output** type (`response_model=TodoSchema`) does, since only the database can\nassign it. Input and output finally use two different shapes, exactly as planned.","locale":"en"},"880":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-17","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint#the-route","content":"**`db_todo = Todo(**todo.dict())`** — `todo` is a Pydantic schema instance; `.dict()` turns it\ninto a plain dict, and `**` unpacks that dict as keyword arguments into `Todo(...)` — turning\nvalidated request data into an actual SQLAlchemy model instance, ready to be saved.","locale":"en"},"881":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-18","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint#the-route","content":"**`db.add(db_todo)`*&#x2A; stages the new row. &#x2A;*`db.commit()`*&#x2A; actually writes it to the\ndatabase. &#x2A;*`db.refresh(db_todo)`** reloads `db_todo` with the values the database assigned\nduring commit — most importantly, the auto-generated `id`, which `db_todo` doesn't have until\nthis line runs.","locale":"en"},"882":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-19","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint#the-route","content":"**`return db_todo`** — returning the SQLAlchemy object directly, which FastAPI converts into\nthe `response_model` shape before sending it back as JSON.","locale":"en"},"883":{"id":"/docs/fastapi/todo-api/create-todo-endpoint-20","page_id":"/docs/fastapi/todo-api/create-todo-endpoint","tags":[],"type":"text","url":"/docs/fastapi/todo-api/create-todo-endpoint#the-route","content":"`Depends(get_db)` is FastAPI's version of dependency injection — the same idea as a Nest\nprovider injected into a controller's constructor, or an Express middleware that attaches\n`req.db` before your handler runs. `@app.post(\"/todos\")` is the same job as Nest's `@Post()`\ndecorator or Express's `router.post()`. And `response_model` is what a Nest response DTO (or\nmanual `class-transformer` serialization) does — controlling exactly what shape leaves your\nAPI, separate from your internal database object.","locale":"en"},"884":{"id":"/docs/fastapi/todo-api/creating-the-todo-model","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","type":"page","content":"Creating the Todo Model","breadcrumbs":["Docs","Backend with FastAPI","Building the Todo API"],"tags":[],"url":"/docs/fastapi/todo-api/creating-the-todo-model","locale":"en"},"885":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-0","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-model","content":"Describing a database table as a Python class","locale":"en"},"886":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-1","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/creating-the-todo-model#what-a-model-actually-is","content":"What a model actually is","locale":"en"},"887":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-2","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/creating-the-todo-model#modelspy","content":"models.py","locale":"en"},"888":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-3","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/creating-the-todo-model#walking-through-it","content":"Walking through it","locale":"en"},"889":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-4","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/creating-the-todo-model#what-this-doesnt-do-yet","content":"What this doesn't do yet","locale":"en"},"890":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-5","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/creating-the-todo-model#modelspy-so-far","content":"`models.py` so far","locale":"en"},"891":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-6","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-model","content":"`database.py` gave you a `Base` class, but nothing inherits from it yet — there's no table\ndescribed anywhere. This lesson creates the first one: a `Todo` model, for the app this\ncourse is building.","locale":"en"},"892":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-7","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-model#what-a-model-actually-is","content":"In an ORM, a **model** is a Python class that represents one database table. Each class\n**attribute** represents one **column** in that table. You'll create actual rows later by\ncreating instances of this class — but the class itself just describes the *shape* of the\ntable.","locale":"en"},"893":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-8","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-model#walking-through-it","content":"**`class Todo(Base):`** — inheriting from `Base` (from `database.py`) is what tells\nSQLAlchemy \"this class describes a database table,\" not just a normal Python class.","locale":"en"},"894":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-9","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-model#walking-through-it","content":"**`__tablename__ = \"todo\"`** — the actual table name SQLAlchemy will use in the database.","locale":"en"},"895":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-10","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-model#walking-through-it","content":"**Each `Column(...)`** describes one field:","locale":"en"},"896":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-11","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-model#walking-through-it","content":"`id = Column(Integer, primary_key=True, index=True)` — a whole number that uniquely\nidentifies each row. `primary_key=True` means the database guarantees it's unique, and\nwill fill it in automatically (1, 2, 3, ...) — you never set it yourself.","locale":"en"},"897":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-12","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-model#walking-through-it","content":"`title = Column(String(200), nullable=False)` — text, capped at 200 characters, and\n`nullable=False` means every todo **must** have a title — the database will reject a row\nwithout one.","locale":"en"},"898":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-13","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-model#walking-through-it","content":"`description = Column(String(500))` — also text, capped at 500 characters, but optional:\nsince `nullable` isn't set, it defaults to `True`, so a todo can exist without a\ndescription.","locale":"en"},"899":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-14","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-model#walking-through-it","content":"`completed = Column(Boolean, default=False)` — true/false, and every new todo starts as\n`False` unless you say otherwise.","locale":"en"},"900":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-15","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-model#walking-through-it","content":"MySQL's `VARCHAR` type **requires** an explicit maximum length — unlike some other databases,\nit simply won't let you create a text column without one. Leave the length off, and you\nwon't notice anything wrong until the moment SQLAlchemy actually tries to create this table,\nwhen it'll fail with `VARCHAR requires a length on dialect mysql`. Pick whatever limit makes\nsense for the field — there's nothing special about 200 or 500 here, just reasonable caps for\na title and a description.","locale":"en"},"901":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-16","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-model#what-this-doesnt-do-yet","content":"Writing this class doesn't create the `todo` table in your actual MySQL database — it just\n*describes* it. Telling SQLAlchemy to actually create the table is a separate step, coming up\nnext.","locale":"en"},"902":{"id":"/docs/fastapi/todo-api/creating-the-todo-model-17","page_id":"/docs/fastapi/todo-api/creating-the-todo-model","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-model#what-this-doesnt-do-yet","content":"This is the same job as a TypeORM `@Entity()` class with `@Column()` decorators, or a Mongoose\nschema — a class that describes a table's shape, which the ORM later uses to generate SQL.\n`primary_key=True` is the same idea as TypeORM's `@PrimaryGeneratedColumn()`, and\n`nullable=False` matches marking a column `NOT NULL` (or a required field in a Mongoose\nschema).","locale":"en"},"903":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","type":"page","content":"Creating the Todo Schema","breadcrumbs":["Docs","Backend with FastAPI","Building the Todo API"],"tags":[],"url":"/docs/fastapi/todo-api/creating-the-todo-schema","locale":"en"},"904":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-0","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema","content":"Pydantic schemas — the shape of data at the API boundary, separate from the database model","locale":"en"},"905":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-1","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/creating-the-todo-schema#why-not-just-reuse-the-model","content":"Why not just reuse the model?","locale":"en"},"906":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-2","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/creating-the-todo-schema#schemaspy","content":"schemas.py","locale":"en"},"907":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-3","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/creating-the-todo-schema#walking-through-it","content":"Walking through it","locale":"en"},"908":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-4","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/creating-the-todo-schema#two-todos-on-purpose","content":"Two `Todo`s, on purpose","locale":"en"},"909":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-5","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/creating-the-todo-schema#schemaspy-so-far","content":"`schemas.py` so far","locale":"en"},"910":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-6","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema","content":"`models.py` describes the `todo` table in your database. Now you need something different: a\nway to describe what data looks like when it travels **in and out of your API** over HTTP.\nThat's what a **schema** is — and it's a separate concept from a model, on purpose.","locale":"en"},"911":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-7","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#why-not-just-reuse-the-model","content":"It's tempting to think \"I already described a `Todo`, why describe it again?\" A few real\nreasons this doesn't work:","locale":"en"},"912":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-8","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#why-not-just-reuse-the-model","content":"**Different fields for different situations.** When a client *creates* a todo, they\nshouldn't have to send `id` — the database assigns it, and it doesn't exist yet. But when\nthe API *returns* a todo, you want `id` included. One shape can't represent both.","locale":"en"},"913":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-9","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#why-not-just-reuse-the-model","content":"**Control over what leaves your API.** A database model can end up with fields you never\nwant a client to see. A schema is where you decide, explicitly, what actually gets sent\nback.","locale":"en"},"914":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-10","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#why-not-just-reuse-the-model","content":"**Different tools for different jobs.** `models.py` uses SQLAlchemy's `Base` — it's built\nfor talking to the database. Schemas use **Pydantic**'s `BaseModel` — the same validation\nlibrary from the very first FastAPI lesson — and it's what FastAPI actually uses to\nvalidate requests and generate your API docs.","locale":"en"},"915":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-11","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#walking-through-it","content":"**`TodoBase`** holds the fields shared by every shape a todo can take — `title`,\n`description`, and `completed`, each written once. Both schemas below build on it. Because\n`completed` has a default (`False`), it's optional wherever it's inherited — a client can\nleave it out entirely and still get a valid todo.","locale":"en"},"916":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-12","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#walking-through-it","content":"**`TodoCreate(TodoBase)`** is what a client sends to create a new todo. It doesn't add\nanything beyond `TodoBase` — everything a client is allowed to provide (`title`,\n`description`, optionally `completed`) is already there. Keeping it as its own class means\nyou can add creation-only fields later without touching the shape used for reading a todo\nback.","locale":"en"},"917":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-13","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#walking-through-it","content":"**`Todo(TodoBase)`** is what the API sends **back**. It adds `id` — the one field that only\nexists once a todo has actually been saved to the database, which is exactly why it's not on\n`TodoCreate`.","locale":"en"},"918":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-14","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#walking-through-it","content":"**`class Config: orm_mode = True`** is the detail that connects this back to your SQLAlchemy\nmodel. By default, a Pydantic schema expects to be built from a plain dict. `orm_mode = True`\ntells it \"it's also fine to build this from an object with matching attributes\" — which is\nexactly what a `models.Todo` instance is. It's what lets you return a SQLAlchemy object\nstraight from a route, and have FastAPI convert it into this schema automatically, field by\nfield — the \"automatic json parsing\" in the comment.","locale":"en"},"919":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-15","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#walking-through-it","content":"`orm_mode` is the Pydantic v1 name for this setting. Newer Pydantic versions renamed it to\n`from_attributes` (set via `model_config = ConfigDict(from_attributes=True)`), but both do\nexactly the same job — you may see either spelling depending on the Pydantic version a\nproject uses.","locale":"en"},"920":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-16","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#two-todos-on-purpose","content":"Notice `models.py` has a `Todo` class, and now `schemas.py` has one too. That's intentional\nand completely safe — they live in separate files, so you refer to them as `models.Todo` and\n`schemas.Todo`. It's a common enough pattern that you'll recognize it instantly once you've\nseen it:","locale":"en"},"921":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-17","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#two-todos-on-purpose","content":"`models.py` (SQLAlchemy)","locale":"en"},"922":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-18","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#two-todos-on-purpose","content":"`schemas.py` (Pydantic)","locale":"en"},"923":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-19","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#two-todos-on-purpose","content":"Describes","locale":"en"},"924":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-20","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#two-todos-on-purpose","content":"A database table","locale":"en"},"925":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-21","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#two-todos-on-purpose","content":"An API request/response shape","locale":"en"},"926":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-22","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#two-todos-on-purpose","content":"Used by","locale":"en"},"927":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-23","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#two-todos-on-purpose","content":"The ORM, to talk to MySQL","locale":"en"},"928":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-24","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#two-todos-on-purpose","content":"FastAPI, to validate and serialize","locale":"en"},"929":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-25","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#two-todos-on-purpose","content":"Base class","locale":"en"},"930":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-26","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#two-todos-on-purpose","content":"`Base`","locale":"en"},"931":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-27","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#two-todos-on-purpose","content":"`BaseModel`","locale":"en"},"932":{"id":"/docs/fastapi/todo-api/creating-the-todo-schema-28","page_id":"/docs/fastapi/todo-api/creating-the-todo-schema","tags":[],"type":"text","url":"/docs/fastapi/todo-api/creating-the-todo-schema#two-todos-on-purpose","content":"This is precisely the separation Nest already pushes you toward: a `CreateTodoDto` (validated\nwith `class-validator`) versus a TypeORM `@Entity()` — \"what the API accepts/returns\" kept\napart from \"what the table looks like.\" In plain Express, it's the difference between a Zod\nor Joi validation schema and a Sequelize/TypeORM model. A Pydantic schema is FastAPI's version\nof a DTO — same idea, same reason for existing.","locale":"en"},"933":{"id":"/docs/fastapi/todo-api/delete-todo","page_id":"/docs/fastapi/todo-api/delete-todo","type":"page","content":"Delete Todo","breadcrumbs":["Docs","Backend with FastAPI","Building the Todo API"],"tags":[],"url":"/docs/fastapi/todo-api/delete-todo","locale":"en"},"934":{"id":"/docs/fastapi/todo-api/delete-todo-0","page_id":"/docs/fastapi/todo-api/delete-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/delete-todo","content":"Removing a row, and returning a plain message instead of the resource","locale":"en"},"935":{"id":"/docs/fastapi/todo-api/delete-todo-1","page_id":"/docs/fastapi/todo-api/delete-todo","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/delete-todo#the-route","content":"The route","locale":"en"},"936":{"id":"/docs/fastapi/todo-api/delete-todo-2","page_id":"/docs/fastapi/todo-api/delete-todo","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/delete-todo#walking-through-it","content":"Walking through it","locale":"en"},"937":{"id":"/docs/fastapi/todo-api/delete-todo-3","page_id":"/docs/fastapi/todo-api/delete-todo","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/delete-todo#mainpy-so-far","content":"`main.py` so far","locale":"en"},"938":{"id":"/docs/fastapi/todo-api/delete-todo-4","page_id":"/docs/fastapi/todo-api/delete-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/delete-todo","content":"The last CRUD operation: removing a todo entirely.","locale":"en"},"939":{"id":"/docs/fastapi/todo-api/delete-todo-5","page_id":"/docs/fastapi/todo-api/delete-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/delete-todo#walking-through-it","content":"**`@app.delete(\"/todos/{todo_id}\")`** — the `DELETE` method, same path parameter pattern as\nfetching or updating a single todo. Notice there's no `response_model` this time — once a\ntodo is deleted, there's no `Todo` left to shape a response around.","locale":"en"},"940":{"id":"/docs/fastapi/todo-api/delete-todo-6","page_id":"/docs/fastapi/todo-api/delete-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/delete-todo#walking-through-it","content":"**Find it, or 404** — the same lookup-then-check pattern from Fetch a Single Todo and Update\nTodo: query by id, and raise `HTTPException(404, ...)` if nothing matches. By now you've\nwritten this exact pattern three times — a good sign it could be pulled into a single shared\ndependency later, once you're comfortable with how `Depends()` works.","locale":"en"},"941":{"id":"/docs/fastapi/todo-api/delete-todo-7","page_id":"/docs/fastapi/todo-api/delete-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/delete-todo#walking-through-it","content":"**`db.delete(todo)`** stages the row for removal — the delete equivalent of `db.add()&#x60;.\n&#x2A;*`db.commit()`** actually removes it from the database.","locale":"en"},"942":{"id":"/docs/fastapi/todo-api/delete-todo-8","page_id":"/docs/fastapi/todo-api/delete-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/delete-todo#walking-through-it","content":"**`return {\"message\":\"Todo deleted successfully\"}`** — a plain Python dict, not a `Todo`.\nSince there's no `response_model` on this route, FastAPI just serializes whatever you return\ndirectly to JSON. Returning a small confirmation message like this is the normal choice for\na delete endpoint — there's nothing meaningful left to hand back.","locale":"en"},"943":{"id":"/docs/fastapi/todo-api/delete-todo-9","page_id":"/docs/fastapi/todo-api/delete-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/delete-todo#walking-through-it","content":"`db.delete(todo)` + `db.commit()` is the same job as `todo.destroy()` in Sequelize,\n`repository.remove(todo)` in TypeORM, or `prisma.todo.delete()` in Prisma. And returning a\nplain `{\"message\": \"...\"}` instead of the deleted resource is exactly what you'd do with\n`res.json({ message: 'Deleted' })` in Express — nothing FastAPI-specific about that choice.","locale":"en"},"944":{"id":"/docs/fastapi/todo-api/delete-todo-10","page_id":"/docs/fastapi/todo-api/delete-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/delete-todo#mainpy-so-far","content":"Every CRUD operation is now in place: create, read all, read one, update, delete.","locale":"en"},"945":{"id":"/docs/fastapi/todo-api/fetch-all-todos","page_id":"/docs/fastapi/todo-api/fetch-all-todos","type":"page","content":"Fetch All Todos","breadcrumbs":["Docs","Backend with FastAPI","Building the Todo API"],"tags":[],"url":"/docs/fastapi/todo-api/fetch-all-todos","locale":"en"},"946":{"id":"/docs/fastapi/todo-api/fetch-all-todos-0","page_id":"/docs/fastapi/todo-api/fetch-all-todos","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-all-todos","content":"A GET endpoint that returns a list, and querying every row with SQLAlchemy","locale":"en"},"947":{"id":"/docs/fastapi/todo-api/fetch-all-todos-1","page_id":"/docs/fastapi/todo-api/fetch-all-todos","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/fetch-all-todos#the-route","content":"The route","locale":"en"},"948":{"id":"/docs/fastapi/todo-api/fetch-all-todos-2","page_id":"/docs/fastapi/todo-api/fetch-all-todos","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/fetch-all-todos#walking-through-it","content":"Walking through it","locale":"en"},"949":{"id":"/docs/fastapi/todo-api/fetch-all-todos-3","page_id":"/docs/fastapi/todo-api/fetch-all-todos","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/fetch-all-todos#mainpy-so-far","content":"`main.py` so far","locale":"en"},"950":{"id":"/docs/fastapi/todo-api/fetch-all-todos-4","page_id":"/docs/fastapi/todo-api/fetch-all-todos","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-all-todos","content":"With creating a todo working, the next endpoint reads them back — every todo in the\ndatabase.","locale":"en"},"951":{"id":"/docs/fastapi/todo-api/fetch-all-todos-5","page_id":"/docs/fastapi/todo-api/fetch-all-todos","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-all-todos#walking-through-it","content":"**`@app.get(\"/todos\", ...)`** — same decorator pattern as `create`, but `@app.get` instead of\n`@app.post`. A `GET` request doesn't carry a request body, which is why `read_todos` doesn't\ntake a `todo` parameter the way `create` did.","locale":"en"},"952":{"id":"/docs/fastapi/todo-api/fetch-all-todos-6","page_id":"/docs/fastapi/todo-api/fetch-all-todos","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-all-todos#walking-through-it","content":"**`response_model = list[TodoSchema]`** — this is the container type hints from Phase 7 of\nPython Notes, now doing real work: `list[TodoSchema]` tells FastAPI \"the response is a list,\nwhere every item is a `TodoSchema`.\" It validates and serializes every item in the returned\nlist the same way a single `response_model=TodoSchema` handles one.","locale":"en"},"953":{"id":"/docs/fastapi/todo-api/fetch-all-todos-7","page_id":"/docs/fastapi/todo-api/fetch-all-todos","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-all-todos#walking-through-it","content":"**`db:Session = Depends(get_db)`** — the same database dependency from the `create` route.\nReading data still needs a session, exactly like writing it did.","locale":"en"},"954":{"id":"/docs/fastapi/todo-api/fetch-all-todos-8","page_id":"/docs/fastapi/todo-api/fetch-all-todos","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-all-todos#walking-through-it","content":"**`db.query(Todo).all()`** — SQLAlchemy's query syntax: `db.query(Todo)` starts a query\nagainst the `todo` table, and `.all()` runs it and returns every matching row, as a list of\n`Todo` (SQLAlchemy) instances. With no filtering added, that means every row in the table.","locale":"en"},"955":{"id":"/docs/fastapi/todo-api/fetch-all-todos-9","page_id":"/docs/fastapi/todo-api/fetch-all-todos","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-all-todos#walking-through-it","content":"**`return db.query(Todo).all()`** — same as `create`: returning SQLAlchemy objects directly,\nand `orm_mode` (from the schema lesson) is what lets FastAPI convert each one into a\n`TodoSchema` automatically.","locale":"en"},"956":{"id":"/docs/fastapi/todo-api/fetch-all-todos-10","page_id":"/docs/fastapi/todo-api/fetch-all-todos","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-all-todos#walking-through-it","content":"`db.query(Todo).all()` is the same job as `Model.findAll()` in Sequelize, `repository.find()`\nin TypeORM, or `prisma.todo.findMany()` in Prisma — \"give me every row,\" with no filter\napplied yet. You'll narrow this down with actual filters once you get to fetching a single\ntodo by id.","locale":"en"},"957":{"id":"/docs/fastapi/todo-api/fetch-single-todo","page_id":"/docs/fastapi/todo-api/fetch-single-todo","type":"page","content":"Fetch a Single Todo","breadcrumbs":["Docs","Backend with FastAPI","Building the Todo API"],"tags":[],"url":"/docs/fastapi/todo-api/fetch-single-todo","locale":"en"},"958":{"id":"/docs/fastapi/todo-api/fetch-single-todo-0","page_id":"/docs/fastapi/todo-api/fetch-single-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-single-todo","content":"Path parameters, filtering a query, and returning a proper 404","locale":"en"},"959":{"id":"/docs/fastapi/todo-api/fetch-single-todo-1","page_id":"/docs/fastapi/todo-api/fetch-single-todo","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/fetch-single-todo#the-route","content":"The route","locale":"en"},"960":{"id":"/docs/fastapi/todo-api/fetch-single-todo-2","page_id":"/docs/fastapi/todo-api/fetch-single-todo","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/fetch-single-todo#path-parameters","content":"Path parameters","locale":"en"},"961":{"id":"/docs/fastapi/todo-api/fetch-single-todo-3","page_id":"/docs/fastapi/todo-api/fetch-single-todo","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/fetch-single-todo#filtering-a-query","content":"Filtering a query","locale":"en"},"962":{"id":"/docs/fastapi/todo-api/fetch-single-todo-4","page_id":"/docs/fastapi/todo-api/fetch-single-todo","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/fetch-single-todo#handling-not-found","content":"Handling \"not found\"","locale":"en"},"963":{"id":"/docs/fastapi/todo-api/fetch-single-todo-5","page_id":"/docs/fastapi/todo-api/fetch-single-todo","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/fetch-single-todo#mainpy-so-far","content":"`main.py` so far","locale":"en"},"964":{"id":"/docs/fastapi/todo-api/fetch-single-todo-6","page_id":"/docs/fastapi/todo-api/fetch-single-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-single-todo","content":"Fetching every todo is useful, but you also need to fetch **one specific** todo — by its id.\nThis introduces two new ideas: reading a value straight out of the URL, and telling the\nclient clearly when something doesn't exist.","locale":"en"},"965":{"id":"/docs/fastapi/todo-api/fetch-single-todo-7","page_id":"/docs/fastapi/todo-api/fetch-single-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-single-todo#path-parameters","content":"**`@app.get(\"/todos/{todo_id}\", ...)`** — the `{todo_id}` inside the path is a **path\nparameter**: a placeholder that matches whatever value actually appears there. Visit\n`/todos/5`, and `todo_id` becomes `5`.","locale":"en"},"966":{"id":"/docs/fastapi/todo-api/fetch-single-todo-8","page_id":"/docs/fastapi/todo-api/fetch-single-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-single-todo#path-parameters","content":"**`def read_todo(todo_id: int, ...)`** — the parameter name has to match the `{todo_id}` in\nthe path exactly. FastAPI reads the value straight from the URL and converts it to whatever\ntype you annotate — `int` here — validating it along the way. Visit `/todos/abc`, and\nFastAPI rejects the request automatically, before your function even runs, because `\"abc\"`\nisn't a valid `int`.","locale":"en"},"967":{"id":"/docs/fastapi/todo-api/fetch-single-todo-9","page_id":"/docs/fastapi/todo-api/fetch-single-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-single-todo#filtering-a-query","content":"Fetch All Todos used `.all()` — every row, no filtering. This route needs exactly one:","locale":"en"},"968":{"id":"/docs/fastapi/todo-api/fetch-single-todo-10","page_id":"/docs/fastapi/todo-api/fetch-single-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-single-todo#filtering-a-query","content":"**`.filter(Todo.id == todo_id)`** narrows the query down to rows where the `id&#x60; column\nmatches. &#x2A;*`.first()`** runs the query and returns just the first matching row — or `None` if\nnothing matched, instead of raising an error the way you might expect.","locale":"en"},"969":{"id":"/docs/fastapi/todo-api/fetch-single-todo-11","page_id":"/docs/fastapi/todo-api/fetch-single-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-single-todo#handling-not-found","content":"Since `.first()` returns `None` for no match, and `None` is falsy, `if not todo:` reads as\n\"if nothing was found.\" `HTTPException` is FastAPI's way of turning a `raise` (Phase 6 of\nPython Notes) into an actual HTTP error response: raising it here stops the function and\nsends the client a real `404` status code, with `{\"detail\": \"Todo not found\"}` as the body —\ninstead of your API returning something confusing, or crashing.","locale":"en"},"970":{"id":"/docs/fastapi/todo-api/fetch-single-todo-12","page_id":"/docs/fastapi/todo-api/fetch-single-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/fetch-single-todo#handling-not-found","content":"A FastAPI path parameter is the same idea as Express's `req.params.id` or Nest's\n`@Param('id') id: number` — except FastAPI also converts and validates the type for you\nautomatically, the way Nest's pipes do. Raising `HTTPException(status_code=404, ...)` is\nexactly `throw new HttpException(...)` in Nest, or `res.status(404).json({...})` written by\nhand in Express — a clean way to end a request early with a specific error response.","locale":"en"},"971":{"id":"/docs/fastapi/todo-api/running-and-testing","page_id":"/docs/fastapi/todo-api/running-and-testing","type":"page","content":"Running & Testing Your API","breadcrumbs":["Docs","Backend with FastAPI","Building the Todo API"],"tags":[],"url":"/docs/fastapi/todo-api/running-and-testing","locale":"en"},"972":{"id":"/docs/fastapi/todo-api/running-and-testing-0","page_id":"/docs/fastapi/todo-api/running-and-testing","tags":[],"type":"text","url":"/docs/fastapi/todo-api/running-and-testing","content":"Starting uvicorn, and trying your endpoint through the interactive docs","locale":"en"},"973":{"id":"/docs/fastapi/todo-api/running-and-testing-1","page_id":"/docs/fastapi/todo-api/running-and-testing","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/running-and-testing#starting-the-server","content":"Starting the server","locale":"en"},"974":{"id":"/docs/fastapi/todo-api/running-and-testing-2","page_id":"/docs/fastapi/todo-api/running-and-testing","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/running-and-testing#testing-it--the-interactive-docs","content":"Testing it — the interactive docs","locale":"en"},"975":{"id":"/docs/fastapi/todo-api/running-and-testing-3","page_id":"/docs/fastapi/todo-api/running-and-testing","tags":[],"type":"text","url":"/docs/fastapi/todo-api/running-and-testing","content":"You have a working endpoint. Time to actually run the server and try it.","locale":"en"},"976":{"id":"/docs/fastapi/todo-api/running-and-testing-4","page_id":"/docs/fastapi/todo-api/running-and-testing","tags":[],"type":"text","url":"/docs/fastapi/todo-api/running-and-testing#starting-the-server","content":"Breaking this down:","locale":"en"},"977":{"id":"/docs/fastapi/todo-api/running-and-testing-5","page_id":"/docs/fastapi/todo-api/running-and-testing","tags":[],"type":"text","url":"/docs/fastapi/todo-api/running-and-testing#starting-the-server","content":"**`uvicorn`** — the server program you installed back in Project Setup. Remember: your\nFastAPI code doesn't run itself; `uvicorn` is what actually starts a server process.","locale":"en"},"978":{"id":"/docs/fastapi/todo-api/running-and-testing-6","page_id":"/docs/fastapi/todo-api/running-and-testing","tags":[],"type":"text","url":"/docs/fastapi/todo-api/running-and-testing#starting-the-server","content":"**`main:app`** — tells `uvicorn` where to find your application: the module `main` (your\n`main.py`), and the variable `app` inside it (`app = FastAPI()`).","locale":"en"},"979":{"id":"/docs/fastapi/todo-api/running-and-testing-7","page_id":"/docs/fastapi/todo-api/running-and-testing","tags":[],"type":"text","url":"/docs/fastapi/todo-api/running-and-testing#starting-the-server","content":"**`--host 0.0.0.0`** — listen on all network interfaces, not just your own machine.\n`127.0.0.1` (the default) only accepts connections from your own computer; `0.0.0.0` also\nlets other devices on your network reach it — useful for testing from your phone, for\nexample.","locale":"en"},"980":{"id":"/docs/fastapi/todo-api/running-and-testing-8","page_id":"/docs/fastapi/todo-api/running-and-testing","tags":[],"type":"text","url":"/docs/fastapi/todo-api/running-and-testing#starting-the-server","content":"**`--port 8000`** — which port to listen on. Your API is now reachable at\n`http://localhost:8000`.","locale":"en"},"981":{"id":"/docs/fastapi/todo-api/running-and-testing-9","page_id":"/docs/fastapi/todo-api/running-and-testing","tags":[],"type":"text","url":"/docs/fastapi/todo-api/running-and-testing#starting-the-server","content":"**`--reload`** — restarts the server automatically whenever you save a code change. Use\nthis constantly during development — you'll rarely want to be without it. &#x2A;*Never use it in\nproduction.**","locale":"en"},"982":{"id":"/docs/fastapi/todo-api/running-and-testing-10","page_id":"/docs/fastapi/todo-api/running-and-testing","tags":[],"type":"text","url":"/docs/fastapi/todo-api/running-and-testing#testing-it--the-interactive-docs","content":"Recall from \"What is FastAPI?\": every FastAPI app automatically gets interactive API docs.\nNow you get to actually use them — open your browser to:","locale":"en"},"983":{"id":"/docs/fastapi/todo-api/running-and-testing-11","page_id":"/docs/fastapi/todo-api/running-and-testing","tags":[],"type":"text","url":"/docs/fastapi/todo-api/running-and-testing#testing-it--the-interactive-docs","content":"You'll see every endpoint you've written listed here — right now, `POST /todos`. Expand it,\nclick **Try it out**, fill in a sample `title` and `description`, and send a real request —\nstraight from the browser, no separate tool required. You'll see the actual response your API\nsent back, including the `id` your database assigned.","locale":"en"},"984":{"id":"/docs/fastapi/todo-api/running-and-testing-12","page_id":"/docs/fastapi/todo-api/running-and-testing","tags":[],"type":"text","url":"/docs/fastapi/todo-api/running-and-testing#testing-it--the-interactive-docs","content":"In Express, you'd reach for Postman or `curl` to test an endpoint, since there's nothing\nbuilt in. Nest gets you close with `@nestjs/swagger`, but it takes manual setup — decorators\non every DTO and route. In FastAPI, this page exists the moment you write your first\nendpoint, generated from the same type hints and schemas you already wrote.","locale":"en"},"985":{"id":"/docs/fastapi/todo-api/update-todo","page_id":"/docs/fastapi/todo-api/update-todo","type":"page","content":"Update Todo — PUT vs PATCH","breadcrumbs":["Docs","Backend with FastAPI","Building the Todo API"],"tags":[],"url":"/docs/fastapi/todo-api/update-todo","locale":"en"},"986":{"id":"/docs/fastapi/todo-api/update-todo-0","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo","content":"Replacing a todo entirely, updating it partially, and the real difference between the two","locale":"en"},"987":{"id":"/docs/fastapi/todo-api/update-todo-1","page_id":"/docs/fastapi/todo-api/update-todo","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/update-todo#put--replace-the-whole-thing","content":"PUT — replace the whole thing","locale":"en"},"988":{"id":"/docs/fastapi/todo-api/update-todo-2","page_id":"/docs/fastapi/todo-api/update-todo","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/update-todo#patch--change-only-what-was-sent","content":"PATCH — change only what was sent","locale":"en"},"989":{"id":"/docs/fastapi/todo-api/update-todo-3","page_id":"/docs/fastapi/todo-api/update-todo","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"PUT vs PATCH","locale":"en"},"990":{"id":"/docs/fastapi/todo-api/update-todo-4","page_id":"/docs/fastapi/todo-api/update-todo","type":"heading","tags":[],"url":"/docs/fastapi/todo-api/update-todo#mainpy-so-far","content":"`main.py` so far","locale":"en"},"991":{"id":"/docs/fastapi/todo-api/update-todo-5","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo","content":"Updating a resource can mean two different things: replacing it completely, or changing just\none field. HTTP has a separate method for each — `PUT` and `PATCH` — and this lesson covers\nboth.","locale":"en"},"992":{"id":"/docs/fastapi/todo-api/update-todo-6","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put--replace-the-whole-thing","content":"The lookup and not-found handling are exactly what you already saw in Fetch a Single Todo.\nWhat's new:","locale":"en"},"993":{"id":"/docs/fastapi/todo-api/update-todo-7","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put--replace-the-whole-thing","content":"**`updated: TodoCreate`** — reusing the same schema from creating a todo. That's deliberate:\n`TodoCreate` requires `title`, so a client calling this route **must** send a full,\ncomplete todo — that's the definition of `PUT`.","locale":"en"},"994":{"id":"/docs/fastapi/todo-api/update-todo-8","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put--replace-the-whole-thing","content":"**`for key, value in updated.dict().items(): setattr(todo, key, value)`** — this loops over\nevery field in the incoming data and uses Python's built-in `setattr(object, name, value)` to\nset it on `todo`, one field at a time. It's the same as writing `todo.title = value`,\n`todo.description = value`, and `todo.completed = value` individually — just without\nrepeating yourself for every field.","locale":"en"},"995":{"id":"/docs/fastapi/todo-api/update-todo-9","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put--replace-the-whole-thing","content":"**`db.commit()` / `db.refresh(todo)` / `return todo`** — save the changes, reload the\ninstance, and return it, the same pattern as creating a todo.","locale":"en"},"996":{"id":"/docs/fastapi/todo-api/update-todo-10","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#patch--change-only-what-was-sent","content":"`PUT` above always overwrites every field, because `TodoCreate` requires all of them. `PATCH`\nis for the opposite case: a client wants to update **just one field** — say, marking a todo\n`completed` — without having to resend the title and description too.","locale":"en"},"997":{"id":"/docs/fastapi/todo-api/update-todo-11","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#patch--change-only-what-was-sent","content":"This needs a schema where every field is optional:","locale":"en"},"998":{"id":"/docs/fastapi/todo-api/update-todo-12","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#patch--change-only-what-was-sent","content":"And a route that only touches the fields actually provided:","locale":"en"},"999":{"id":"/docs/fastapi/todo-api/update-todo-13","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#patch--change-only-what-was-sent","content":"The one detail that makes this actually work as a *partial&#x2A; update is\n&#x2A;*`exclude_unset=True`**. Without it, `updated.dict()` would include every field on\n`TodoUpdate` — and any field the client didn't send would show up as `None`, wiping it out in\nthe database. `exclude_unset=True` means \"only include fields the client actually sent in the\nrequest\" — so `{\"completed\": true}` updates just `completed`, and leaves `title` and\n`description` untouched.","locale":"en"},"1000":{"id":"/docs/fastapi/todo-api/update-todo-14","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#patch--change-only-what-was-sent","content":"Unlike the earlier lessons, this `TodoUpdate` schema and `partial_update_todo` route are a\nworked example for this topic, not code pulled from your `fastapi-todo` project — add them\nyourself if you want `PATCH` support, then let me know and I'll sync this lesson to your\nactual code, the same as every other topic.","locale":"en"},"1001":{"id":"/docs/fastapi/todo-api/update-todo-15","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"`PUT`","locale":"en"},"1002":{"id":"/docs/fastapi/todo-api/update-todo-16","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"`PATCH`","locale":"en"},"1003":{"id":"/docs/fastapi/todo-api/update-todo-17","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"Meaning","locale":"en"},"1004":{"id":"/docs/fastapi/todo-api/update-todo-18","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"Replace the entire resource","locale":"en"},"1005":{"id":"/docs/fastapi/todo-api/update-todo-19","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"Update part of it","locale":"en"},"1006":{"id":"/docs/fastapi/todo-api/update-todo-20","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"Client sends","locale":"en"},"1007":{"id":"/docs/fastapi/todo-api/update-todo-21","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"Every field","locale":"en"},"1008":{"id":"/docs/fastapi/todo-api/update-todo-22","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"Only the fields changing","locale":"en"},"1009":{"id":"/docs/fastapi/todo-api/update-todo-23","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"Schema needs","locale":"en"},"1010":{"id":"/docs/fastapi/todo-api/update-todo-24","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"Required fields (`TodoCreate`)","locale":"en"},"1011":{"id":"/docs/fastapi/todo-api/update-todo-25","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"Every field optional (`TodoUpdate`)","locale":"en"},"1012":{"id":"/docs/fastapi/todo-api/update-todo-26","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"Omitted field","locale":"en"},"1013":{"id":"/docs/fastapi/todo-api/update-todo-27","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"Overwritten (often cleared)","locale":"en"},"1014":{"id":"/docs/fastapi/todo-api/update-todo-28","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"Left unchanged","locale":"en"},"1015":{"id":"/docs/fastapi/todo-api/update-todo-29","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"A useful way to remember it: &#x2A;*PUT says \"here's the whole new version\"; PATCH says \"here's\nwhat changed.\"**","locale":"en"},"1016":{"id":"/docs/fastapi/todo-api/update-todo-30","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#put-vs-patch","content":"Same distinction Nest already makes with `@Put()` versus `@Patch()` decorators, or Express's\n`router.put()` versus `router.patch()` — the HTTP methods and their meaning don't change.\nWhat's different is FastAPI leaning on two separate Pydantic schemas (required vs. all\n`Optional`) to enforce the distinction, instead of validating a DTO's completeness by hand.","locale":"en"},"1017":{"id":"/docs/fastapi/todo-api/update-todo-31","page_id":"/docs/fastapi/todo-api/update-todo","tags":[],"type":"text","url":"/docs/fastapi/todo-api/update-todo#mainpy-so-far","content":"This reflects your actual project — the `PUT` route only. The `PATCH` example above isn't\nincluded here, since it's not part of `fastapi-todo` yet.","locale":"en"},"1018":{"id":"/tanglish/docs/final-practice","page_id":"/tanglish/docs/final-practice","type":"page","content":"Final Practice — Build a User Store","breadcrumbs":["Docs","Python Notes"],"tags":[],"url":"/tanglish/docs/final-practice","locale":"tanglish"},"1019":{"id":"/tanglish/docs/final-practice-0","page_id":"/tanglish/docs/final-practice","tags":[],"type":"text","url":"/tanglish/docs/final-practice","content":"Tutorial-a close pannitu idha nee build pannu — FastAPI ku best prep","locale":"tanglish"},"1020":{"id":"/tanglish/docs/final-practice-1","page_id":"/tanglish/docs/final-practice","type":"heading","tags":[],"url":"/tanglish/docs/final-practice#the-store","content":"The store","locale":"tanglish"},"1021":{"id":"/tanglish/docs/final-practice-2","page_id":"/tanglish/docs/final-practice","type":"heading","tags":[],"url":"/tanglish/docs/final-practice#given--idha-first-study-pannu","content":"Given — idha first study pannu","locale":"tanglish"},"1022":{"id":"/tanglish/docs/final-practice-3","page_id":"/tanglish/docs/final-practice","type":"heading","tags":[],"url":"/tanglish/docs/final-practice#nee-turn","content":"Nee turn","locale":"tanglish"},"1023":{"id":"/tanglish/docs/final